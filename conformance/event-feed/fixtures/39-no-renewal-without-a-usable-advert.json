{
  "name": "39-no-renewal-without-a-usable-advert",
  "description": "Renewal is offered per socket by the welcome, and only a usable advert offers it. A welcome whose stream_expires_at is not an RFC 3339 string (here a number) is NO advert — read leniently, never the invalid-frame class, so the handshake proceeds and the socket is not torn down — and Streaming's exact set stays {staleness, repair-poll}: no renew-due, ever. A `renewed` frame on that socket, on the subscription's own identifier, answers nothing and is liveness, never adopted as a deadline. A live event is delivered on the same socket.",
  "config": {
    "position": "{{POS:0}}"
  },
  "steps": [
    {
      "expectMint": {
        "respond": {
          "status": 200,
          "body": {
            "ticket": "{{TICKET:1}}",
            "expires_in": 120,
            "url": "{{CABLE_URL:1}}"
          }
        }
      }
    },
    {
      "expectConnect": {
        "url": "{{CABLE_URL:1}}"
      }
    },
    {
      "serve": {
        "frame": "raw",
        "text": "{\"type\":\"welcome\",\"stream_expires_at\":1767229200}"
      }
    },
    {
      "expectSubscribe": {
        "channel": "EventsChannel"
      }
    },
    {
      "serve": {
        "frame": "confirm"
      }
    },
    {
      "expectPoll": {
        "query": {
          "position": "{{POS:0}}"
        },
        "respond": {
          "status": 200,
          "body": {
            "events": [],
            "position": "{{POS:1}}"
          }
        }
      }
    },
    {
      "expectCheckpoint": {
        "position": "{{POS:1}}"
      }
    },
    {
      "expectState": {
        "is": "streaming"
      }
    },
    {
      "expectTimers": {
        "exact": {
          "staleness": 1,
          "repair-poll": 1
        }
      }
    },
    {
      "serve": {
        "frame": "renewed",
        "streamExpiresInMs": 7200000
      }
    },
    {
      "serve": {
        "frame": "message",
        "event": {
          "id": 3,
          "kind": "message",
          "event_type": "message.created",
          "action": "created",
          "created_at": "2026-08-01T12:00:00Z",
          "bucket_id": 2,
          "creator_id": 3,
          "performed_by_id": null,
          "actor_type": "person",
          "recording_id": 900,
          "visible_to_clients": false
        }
      }
    },
    {
      "expectDelivered": {
        "exact": [3]
      }
    },
    {
      "expectTimers": {
        "exact": {
          "staleness": 1,
          "repair-poll": 1
        }
      }
    }
  ],
  "finally": {
    "state": "streaming",
    "mintCount": 1,
    "connectCount": 1,
    "delivered": {
      "exact": [3]
    },
    "checkpoints": {
      "exact": ["{{POS:1}}"]
    },
    "timers": {
      "exact": {
        "staleness": 1,
        "repair-poll": 1
      }
    },
    "socket": "open"
  }
}
