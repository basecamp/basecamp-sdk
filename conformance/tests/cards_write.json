[
  {
    "name": "update-sends-only-what-the-caller-addressed: one PUT, no preservation GET",
    "description": "BC3's JSON card update is presence-aware since basecamp/bc3#12521: an omitted key is left unchanged and an explicit \"\" clears (Rails blank-cast, pinned by a BC3 server test). A sparse PUT is therefore safe on its own, so the composite no longer GETs the card to resend its due_on. One request, and due_on stays OFF the wire when the caller did not address it — echoing it back would reintroduce the read-modify-write race the GET's removal exists to eliminate. assignee_ids stays absent for a second reason that has not changed: BC3 filters incoming ids through reachable_people, so echoing them back could unassign someone who lost board access.",
    "operation": "UpdateCard",
    "method": "PUT",
    "path": "/card_tables/cards/{cardId}",
    "pathParams": {
      "cardId": 1069479350
    },
    "requestBody": {
      "title": "Renamed card"
    },
