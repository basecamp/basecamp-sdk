  {
    "name": "CreateDoor 422 maps to validation",
    "description": "An unusable url (a javascript: address, say) answers 422 with field-keyed errors, and nothing is saved.",
    "operation": "CreateDoor",
    "method": "POST",
    "path": "/buckets/{bucketId}/dock/doors.json",
    "pathParams": {
      "bucketId": 2085958504
    },
    "requestBody": {
      "door": {
        "service": "other",
        "url": "javascript:alert(1)"
      }
    },
    "mockResponses": [
      {
        "status": 422,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "errors": {
            "url": [
              "is invalid"
            ]
          }
        }
      }
    ],
    "assertions": [
      {
        "type": "errorCode",
        "expected": "validation"
      },
      {
        "type": "errorField",
        "path": "httpStatus",
        "expected": 422
      },
      {
        "type": "requestCount",
        "expected": 1
      }
    ],
    "tags": [
      "doors",
      "create",
      "error-mapping"
    ]
  },
