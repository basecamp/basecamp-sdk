      {
        "type": "errorCode",
        "expected": "validation"
      },
      {
        "type": "errorField",
        "path": "httpStatus",
        "expected": 400
      },
      {
        "type": "errorMessage",
        "expected": "payload_url: is not a valid URL"
      }
    ],
    "tags": [
      "error-mapping",
      "validation",
      "field-errors",
      "structured-error"
    ]
  },
  {
