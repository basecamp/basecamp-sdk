  {
    "name": "422 field-keyed errors treat __proto__ as an ordinary field name",
    "description": "Verifies an untrusted field name that collides with JavaScript's legacy prototype setter is kept as an ordinary map key in every SDK \u2014 present in the flattened message and never mutating the map",
    "operation": "UpdateCalendar",
    "method": "PUT",
    "path": "/calendars/{calendarId}",
    "pathParams": {
      "calendarId": 2085958497
    },
    "requestBody": {
      "calendar": {
        "color": "chartreuse"
      }
    },
    "mockResponses": [
      {
        "status": 422,
        "body": {
          "errors": {
            "__proto__": [
              "is reserved"
            ],
            "color": [
              "is not a valid color"
            ]
          }
        }
      }
    ],
    "assertions": [
      {
        "type": "errorCode",
        "expected": "validation"
      },
      {
        "type": "errorMessage",
        "expected": "__proto__: is reserved, color: is not a valid color"
      }
    ],
    "tags": [
      "error-mapping",
      "validation",
      "field-errors",
      "structured-error"
    ]
  },
  {
    "name": "422 field-keyed errors keep valid entries beside malformed ones",
    "description": "Verifies a mixed-validity errors map ({\"color\": [...], \"base\": \"invalid\"}) reaches the tolerant parser in every SDK \u2014 the valid entry is flattened and the malformed sibling skipped, rather than a typed-decode failure surfacing to the caller",
    "operation": "UpdateCalendar",
    "method": "PUT",
    "path": "/calendars/{calendarId}",
    "pathParams": {
      "calendarId": 2085958497
    },
    "requestBody": {
      "calendar": {
        "color": "chartreuse"
      }
    },
    "mockResponses": [
      {
        "status": 422,
        "body": {
          "errors": {
            "color": [
              "is not a valid color"
            ],
            "base": "invalid"
          }
        }
      }
    ],
    "assertions": [
      {
        "type": "errorCode",
        "expected": "validation"
      },
      {
        "type": "errorMessage",
        "expected": "color: is not a valid color"
      }
    ],
    "tags": [
      "error-mapping",
      "validation",
      "field-errors",
      "structured-error"
    ]
  },
  {
    "name": "400 bare field-map body flattens into the validation message",
