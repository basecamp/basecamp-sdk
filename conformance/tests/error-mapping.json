  {
    "name": "422 field-keyed errors flatten into the validation message",
    "description": "Verifies that a field-keyed 422 body ({\"errors\": {field: [messages]}} \u2014 the Rails RecordInvalid rendering, e.g. UpdateCalendar rejecting an unknown color) is flattened into the error message",
    "operation": "UpdateCalendar",
    "method": "PUT",
    "path": "/calendars/{calendarId}",
    "pathParams": {
      "calendarId": 2085958497
    },
    "requestBody": {
      "calendar": {
        "color": "chartreuse"
      }
    },
    "mockResponses": [
      {
        "status": 422,
        "body": {
          "errors": {
            "color": [
              "is not a valid color"
            ]
          }
        }
      }
    ],
    "assertions": [
      {
        "type": "errorCode",
        "expected": "validation"
      },
      {
        "type": "errorField",
        "path": "httpStatus",
        "expected": 422
      },
      {
        "type": "errorMessage",
        "expected": "color: is not a valid color"
      }
    ],
    "tags": [
      "error-mapping",
      "validation",
      "field-errors",
      "structured-error"
    ]
  },
  {
    "name": "422 field-keyed errors flatten sorted with multi-message fields",
    "description": "Verifies the shared flattening shape: fields sorted lexicographically, a field's messages joined with '; ', fields joined with ', '",
    "operation": "UpdateCalendar",
    "method": "PUT",
    "path": "/calendars/{calendarId}",
    "pathParams": {
      "calendarId": 2085958497
    },
    "requestBody": {
      "calendar": {
        "color": "chartreuse"
      }
    },
    "mockResponses": [
      {
        "status": 422,
        "body": {
          "errors": {
            "name": [
              "can't be blank",
              "is too short"
            ],
            "color": [
              "is not a valid color"
            ]
          }
        }
      }
    ],
    "assertions": [
      {
        "type": "errorCode",
        "expected": "validation"
      },
      {
        "type": "errorMessage",
        "expected": "color: is not a valid color, name: can't be blank; is too short"
      }
    ],
    "tags": [
      "error-mapping",
      "validation",
      "field-errors",
      "structured-error"
    ]
  },
