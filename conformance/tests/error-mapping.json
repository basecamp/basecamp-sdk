    "method": "POST",
    "path": "/buckets/{bucketId}/webhooks.json",
    "pathParams": {
      "bucketId": 456
    },
    "requestBody": {
      "payload_url": "https://example.com/hook",
      "types": [
        "Todo"
      ]
    },
    "mockResponses": [
      {
        "status": 400,
        "body": {
          "types": [
            "is invalid"
          ],
