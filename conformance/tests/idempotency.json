      {
        "status": 503
      }
    ],
    "assertions": [
      {
        "type": "requestCount",
        "expected": 1
      },
      {
        "type": "statusCode",
        "expected": 503
      }
    ],
    "tags": [
      "no-retry",
      "post"
    ]
  },
