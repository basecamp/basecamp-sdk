          "updated_at": "2026-07-21T00:02:30.308Z",
          "content": "<div>Things to remember</div>",
          "content_attachments": [],
          "url": "https://3.basecampapi.com/999/my/notes.json",
          "app_url": "https://3.basecamp.com/999/my/navigation/notes"
        }
      }
    ],
    "assertions": [
      {
        "type": "requestCount",
        "expected": 2
      },
      {
        "type": "noError"
      }
    ],
    "tags": [
      "idempotent",
      "put"
    ]
  },
