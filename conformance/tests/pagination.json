  {
    "name": "maxItems caps results across pages",
    "description": "Verifies that maxItems option caps the total items returned, stopping pagination early when enough items are collected (2C.4, 2C.6)",
    "operation": "ListProjects",
    "method": "GET",
    "path": "/projects.json",
    "configOverrides": {
      "maxItems": 3
    },
    "mockResponses": [
      {
        "status": 200,
        "headers": {
          "Link": "</projects.json?page=2>; rel=\"next\""
        },
        "body": [
          {"id": 1, "status": "active", "created_at": "2025-01-01T00:00:00Z", "updated_at": "2025-01-01T00:00:00Z", "name": "Project 1", "url": "https://3.basecampapi.com/999/projects/1.json", "app_url": "https://3.basecamp.com/999/projects/1"},
