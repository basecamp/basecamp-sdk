  {
    "name": "ListPings accepts an empty array",
    "description": "A caller with no Pings gets 200 with an empty array, which decodes to an empty list rather than an error.",
    "operation": "ListPings",
    "method": "GET",
    "path": "/circles.json",
    "mockResponses": [
      {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": []
      }
    ],
    "assertions": [
      {
        "type": "noError"
      },
      {
        "type": "requestCount",
        "expected": 1
      },
      {
        "type": "responseBody",
        "path": "ping_count",
        "expected": 0
      }
    ],
    "tags": [
      "pings",
      "decode"
    ]
  },
  {
    "name": "ListPings surfaces disabled Pings as forbidden",
    "description": "An account with Pings turned off answers the list with 403, which SPEC §6 maps to `forbidden` by status and must not be swallowed into an empty list.",
    "operation": "ListPings",
    "method": "GET",
    "path": "/circles.json",
    "mockResponses": [
      {
        "status": 403,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "error": "Pings have been disabled"
        }
      }
    ],
    "assertions": [
      {
        "type": "requestCount",
        "expected": 1
      },
      {
        "type": "errorCode",
        "expected": "forbidden"
      },
      {
        "type": "errorField",
        "path": "httpStatus",
        "expected": 403
      }
    ],
    "tags": [
      "pings",
      "error-mapping"
    ]
  },
