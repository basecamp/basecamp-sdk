  {
    "name": "CreatePing maps a bodiless 422 to a validation error",
    "description": "BC3 answers 422 with no body (BareValidationError — the spec advertises no decodable body) when the Ping would have no person in it who can use Pings, which only happens to an agent asking for only other agents. SPEC §6 maps it to `validation` by status.",
    "operation": "CreatePing",
    "method": "POST",
    "path": "/circles.json",
    "requestBody": {
      "user_ids": [
        1049715915
      ]
    },
    "mockResponses": [
      {
        "status": 422
      }
    ],
    "assertions": [
      {
        "type": "requestCount",
        "expected": 1
      },
      {
        "type": "errorCode",
        "expected": "validation"
      },
      {
        "type": "errorField",
        "path": "httpStatus",
        "expected": 422
      },
      {
        "type": "errorField",
        "path": "retryable",
        "expected": false
      }
    ],
    "tags": [
      "pings",
      "create",
      "error-mapping",
      "validation"
    ]
  }
