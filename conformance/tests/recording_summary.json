  {
    "name": "RecordingsSummarize refuses boost.created before any request",
    "description": "boost.created names no recording type (the row points at the boost's target, whose type it does not carry), so the helper refuses it distinctly rather than reading something it is not. No request is made.",
    "operation": "RecordingsSummarize",
    "method": "GET",
    "path": "/comments/1069479361",
    "pathParams": {
      "bucketId": 2085958499,
      "recordingId": 1069479361,
      "eventType": "boost.created"
    },
    "mockResponses": [],
    "assertions": [
      {
        "type": "requestCount",
        "expected": 0
      },
      {
        "type": "errorMessage",
        "expected": "names no recording type"
      }
    ],
    "tags": [
      "recording-summary",
      "error"
    ]
  },
