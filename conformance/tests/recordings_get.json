    "method": "GET",
    "path": "/recordings/{recordingId}",
    "pathParams": {
      "recordingId": 1
    },
    "mockResponses": [
      {
        "status": 404,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "error": "Not found"
        }
      }
    ],
    "assertions": [
      {
        "type": "errorCode",
        "expected": "not_found"
