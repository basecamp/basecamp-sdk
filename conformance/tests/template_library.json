  {
    "name": "template library copy creation sends destination and confirmation",
    "description": "Verifies the create-copy path, request field names, 201 response, and pending copy shape.",
    "operation": "CreateTemplateLibraryCopy",
    "method": "POST",
    "path": "/template_library/copies.json",
    "requestBody": {
      "template_recording_id": 3,
      "destination_parent_id": 9,
      "adding_people_confirmed": true
    },
    "mockResponses": [
      {
        "status": 201,
        "headers": { "Content-Type": "application/json" },
        "body": {
          "id": 5,
          "status": "pending",
          "source_recording_id": 3,
          "destination_parent_id": 9,
          "url": "https://3.basecampapi.com/999/template_library/copies/5.json"
        }
      }
    ],
    "assertions": [
      { "type": "noError" },
      { "type": "requestCount", "expected": 1 },
      { "type": "requestMethod", "expected": "POST" },
      { "type": "requestPath", "expected": "/999/template_library/copies.json" },
      { "type": "requestBody", "path": "template_recording_id", "expected": 3 },
      { "type": "requestBody", "path": "destination_parent_id", "expected": 9 },
      { "type": "requestBody", "path": "adding_people_confirmed", "expected": true },
      { "type": "responseBody", "path": "id", "expected": 5 },
      { "type": "responseBody", "path": "status", "expected": "pending" }
    ],
    "tags": ["templates", "template-library", "write"]
  },
