  {
    "name": "template library copy reports people confirmation as a validation error",
    "description": "Verifies that the documented 422 people-confirmation response is surfaced as the shared validation error while retaining its message.",
    "operation": "CreateTemplateLibraryCopy",
    "method": "POST",
    "path": "/template_library/copies.json",
    "requestBody": {
      "template_recording_id": 3,
      "destination_parent_id": 9
    },
    "mockResponses": [
      {
        "status": 422,
        "headers": { "Content-Type": "application/json" },
        "body": {
          "error": "Adding people requires confirmation",
          "people": [
            { "id": 4, "name": "Victor", "avatar_url": "https://3.basecamp.com/avatars/4.png" }
          ]
        }
      }
    ],
    "assertions": [
      { "type": "errorCode", "expected": "validation" },
      { "type": "errorField", "path": "httpStatus", "expected": 422 },
      { "type": "errorMessage", "expected": "Adding people requires confirmation" }
    ],
    "tags": ["templates", "template-library", "error-mapping", "validation"]
  }
]
