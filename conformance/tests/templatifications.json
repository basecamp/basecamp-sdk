  {
    "name": "templatifying a recording reports a pending record with no destination parent",
    "description": "Verifies the templatify path and that the record omits destination_parent_id, which is what distinguishes it from a copy: the destination is always the library and the caller never names it.",
    "operation": "CreateTemplatification",
    "method": "POST",
    "path": "/buckets/{bucketId}/recordings/{recordingId}/templatifications.json",
    "pathParams": {
      "bucketId": 8,
      "recordingId": 40
    },
    "requestBody": {
      "template_name": "Client onboarding",
      "copy_assignments": true
    },
    "mockResponses": [
      {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "id": 2,
          "status": "pending",
          "source_recording_id": 40,
          "url": "https://3.basecampapi.com/999/buckets/8/recordings/40/templatifications/2.json"
        }
      }
    ],
    "assertions": [
      {
        "type": "noError"
      },
      {
        "type": "requestCount",
        "expected": 1
      },
      {
        "type": "requestMethod",
        "expected": "POST"
      },
      {
        "type": "requestPath",
        "expected": "/999/buckets/8/recordings/40/templatifications.json"
      },
      {
        "type": "requestBody",
        "path": "template_name",
        "expected": "Client onboarding"
      },
      {
        "type": "requestBody",
        "path": "copy_assignments",
        "expected": true
      },
      {
        "type": "responseBody",
        "path": "id",
        "expected": 2
      },
      {
        "type": "responseBody",
        "path": "status",
        "expected": "pending"
      }
    ],
    "tags": [
      "templates",
      "templatification",
      "write"
    ]
  },
  {
    "name": "an unaddressed templatification sends no attributes at all",
    "description": "Every templatification attribute is optional and a bodyless request is valid, so an unaddressed one must leave each key off the wire rather than sending a default. template_name in particular: sending an empty one would name the template empty instead of letting bc3 fall back to the source recording's own title.",
    "operation": "CreateTemplatification",
    "method": "POST",
    "path": "/buckets/{bucketId}/recordings/{recordingId}/templatifications.json",
    "pathParams": {
      "bucketId": 8,
      "recordingId": 40
    },
    "requestBody": {},
    "mockResponses": [
      {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "id": 3,
          "status": "pending",
          "source_recording_id": 40,
          "url": "https://3.basecampapi.com/999/buckets/8/recordings/40/templatifications/3.json"
        }
      }
    ],
    "assertions": [
      {
        "type": "noError"
      },
      {
        "type": "requestCount",
        "expected": 1
      },
      {
        "type": "requestBodyAbsent",
        "path": "template_name"
      },
      {
        "type": "requestBodyAbsent",
        "path": "copy_comments"
      },
      {
        "type": "requestBodyAbsent",
        "path": "copy_assignments"
      },
      {
        "type": "requestBodyAbsent",
        "path": "move_cards_to_triage"
      },
      {
        "type": "responseBody",
        "path": "status",
        "expected": "pending"
      }
    ],
    "tags": [
      "templates",
      "templatification",
      "write",
      "unaddressed"
    ]
  },
