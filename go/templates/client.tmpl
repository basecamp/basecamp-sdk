// attempt (never returns a nil response with a nil error).
func (cfg RetryConfig) effectiveMaxAttempts() (int, error) {
	if cfg.MaxRetries < 0 {
		return 0, fmt.Errorf("basecamp: invalid RetryConfig: MaxRetries must be >= 0, got %d", cfg.MaxRetries)
