#!/usr/bin/env bash
#
# assert-lockfiles-unchanged — observe, rather than predict, that `make check`
# left every dependency manifest byte-identical: npm lockfiles, Gemfile.lock,
# uv.lock, and the Go checksum files, which `go` rewrites as readily as `npm`
# rewrites a lockfile.
#
# `--record` before the checks, `--verify` after. Both are wired into the `check`
# target, so `make check` proves the property on every run.
#
# ---------------------------------------------------------------------------
# Why this exists alongside check-npm-lockfile-readonly
#
# That gate is static: it reads recipes and lifecycle scripts and decides whether
# each npm invocation can write. It is fail-closed wherever it *classifies*
# something — an unknown subcommand, an unrecognised option, an unresolvable
# subcommand are all reported — but there is one place it cannot be, and review
# found spelling after spelling there: deciding whether a word IS a command in
# the first place. `n"p"m`, `np\m`, `CI=1 npm`, `sh -c '…'`, `npm exec -- …`.
# Each was a real hole, each got a rule, and the next spelling is always
# available, because separating code from data is shell parsing and this is not a
# shell.
#
# The obvious inversion — treat anything unclassifiable as a failure — does not
# work at that layer. Review independently reported two false alarms of exactly
# that kind (`echo ok # npm install …`, `echo "please npm install here"`), and
# neither had an allowlist remedy: prose and diagnostics mention npm constantly.
# A gate that fails on every quoted mention would be turned off within a week.
#
# So the static gate stays what it is — a regression guard that catches the
# accidental reintroduction, which is what actually happened in #612 — and this
# check covers what it cannot. It does not parse anything. It hashes the
# lockfiles before the checks run and again afterwards, and any difference is a
# failure. `eval` on an assembled string, a subcommand held in a variable, a
# writer three Makefiles deep, a spelling nobody has thought of yet: all of them
# change bytes on disk, and none of them can evade a comparison of those bytes.
#
# The two are complementary and neither is redundant. The static gate fails at
# the commit that introduces the writer, naming the file and line, and it works
# on machines where the write happens to be a no-op. This one cannot say what
# went wrong, only that something did — but nothing can talk it out of noticing.

set -uo pipefail
export LC_ALL=C

cd "${CHECK_NPM_ROOT:-$(dirname "$0")/..}" || exit 1

# One snapshot per invocation. `make check` allocates it with mktemp and passes
# the same path to --record and --verify, because this repo is worked in from
# ~30 worktrees at once: a path keyed only on the user was shared between
# concurrent runs, and the second --record overwrote the first run's baseline.
# The fallback is keyed on the repo root so a bare manual run still cannot
# collide with a sibling worktree.
if [[ -n "${LOCKFILE_SNAPSHOT:-}" ]]; then
  SNAPSHOT=$LOCKFILE_SNAPSHOT
else
  root_key=$(pwd -P | cksum | tr -d ' ')
  SNAPSHOT=${TMPDIR:-/tmp}/basecamp-sdk-lockfiles.$(id -u).${root_key}.sha
fi

# Walk the filesystem, not the index. `git ls-files` lists only what is already
# tracked, so a lockfile CREATED during the checks — a root package-lock.json,
# say — appeared in neither snapshot and the comparison passed while the tree was
# left dirty. A file that did not exist before and does now is exactly the thing
# this is looking for.
hash_lockfiles() {
  local f
  while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    if command -v sha256sum >/dev/null 2>&1; then
      sha256sum "$f"
    else
      shasum -a 256 "$f"
    fi
  done < <(find . \
             \( -name node_modules -o -name .git -o -name dist -o -name build \) -prune \
             -o -type f \( -name 'package-lock.json' -o -name 'Gemfile.lock' \
                           -o -name 'uv.lock' -o -name 'go.sum' \
                           -o -name 'go.work.sum' \) -print \
           | LC_ALL=C sort)
}

case "${1:-}" in
  --record)
    hash_lockfiles > "$SNAPSHOT"
    exit 0
    ;;
  --verify)
    if [[ ! -f "$SNAPSHOT" ]]; then
      echo "assert-lockfiles-unchanged: no snapshot at $SNAPSHOT — run --record first." >&2
      exit 1
    fi
    after=$(hash_lockfiles)
    if [[ "$after" == "$(cat "$SNAPSHOT")" ]]; then
      count=$(printf '%s\n' "$after" | grep -c . || true)
      echo "Lockfiles unchanged by the checks ($count files, byte-identical)."
      exit 0
    fi
    echo "FAIL: the checks modified a dependency lockfile." >&2
    echo >&2
    diff <(cat "$SNAPSHOT") <(printf '%s\n' "$after") \
      | sed -n 's/^[<>] /      /p' | sort -u >&2
    echo >&2
    printf '%s\n' \
      "Nothing \`make check\` runs may write a lockfile — a dirty tree blocks the" \
      "release flow, and what gets written depends on which npm ran it (#612)." \
      "Use \`npm ci\`, which installs from the lockfile without writing it back." >&2
    exit 1
    ;;
  *)
    echo "usage: $0 --record | --verify" >&2
    exit 2
    ;;
esac
