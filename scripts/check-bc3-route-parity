#!/usr/bin/env ruby
# frozen_string_literal: true

# Compare the SDK's declared HTTP routes against the routes bc3 actually serves.
#
# This is the gate that would have caught two shipped operations pointing at URLs
# that do not exist:
#
#   ListForwards             GET /{accountId}/inboxes/{inboxId}/forwards.json
#                            bc3 serves .../inbox_forwards.json
#   RepositionTodolistGroup  PUT /{accountId}/todolists/{groupId}/position.json
#                            bc3 serves /todolists/groups/{id}/position.json
#
# Nothing compared the two sides before. `make url-routes-check` proves
# go/pkg/basecamp/url-routes.json regenerates FROM openapi.json — it is a
# self-consistency check, and a route that is internally consistent and wrong
# passes it. Neither operation appeared in the live-canary fixture set either, so
# both 404'd in shipped consumers.
#
# Runs fully OFFLINE against the vendored spec/bc3-routes.json, so it is in
# `make check` and in CI with no bc3 checkout and no secret. That is deliberate:
# a gate that skips when its input is missing cannot prevent anything, and
# skipping is exactly how this class of defect survived.
#
# Refresh the vendored table with:  make bc3-routes   (requires BC3_REPO_PATH)
#
# BC3_ROUTE_ALLOWLIST overrides the allowlist path, so
# scripts/test-check-bc3-route-parity.rb can drive adversarial entries through
# this gate against the REAL route tables. openapi.json and spec/bc3-routes.json
# are deliberately NOT overridable — a self-test against invented routes proves
# nothing about the routes we ship.
#
# Usage: ./check-bc3-route-parity

require 'json'
require 'set'
require 'yaml'
require 'digest'
require_relative 'bc3_route_normalizer'

N = Bc3RouteNormalizer
ROOT = File.expand_path('..', __dir__)

# Fail-closed floors. Pinned literals in the style of expected_idempotent=77 in
# check-idempotency-parity. Without these, a broken extraction regex yields an
# empty route set, nothing is unmatched, and the gate passes vacuously — the
# review-census-403 failure mode.
MIN_BC3_ROUTES = 340
MIN_SDK_ROUTES = 230

failures = []
def die(failures)
  warn '==> bc3 route parity FAILED:'
  failures.each { |f| warn "  #{f}" }
  exit 1
end

# ---------------------------------------------------------------- load + verify

table_path = File.join(ROOT, 'spec', 'bc3-routes.json')
unless File.exist?(table_path)
  warn "ERROR: #{table_path} is missing. Run `make bc3-routes` (needs BC3_REPO_PATH)."
  exit 1
end

table = JSON.parse(File.read(table_path, encoding: "UTF-8"))
provenance = JSON.parse(File.read(File.join(ROOT, 'spec', 'api-provenance.json'), encoding: "UTF-8"))
pinned = provenance.fetch('bc3').fetch('revision')
vendored = table.fetch('source').fetch('revision')

# The table must describe the revision the SDK claims to be synced against.
# Otherwise the gate silently compares against stale bc3 truth, which is worse
# than not comparing at all — it looks green.
if vendored != pinned
  failures << "spec/bc3-routes.json is stale: built from bc3 #{vendored[0, 10]}, " \
              "but spec/api-provenance.json pins #{pinned[0, 10]}. Run `make bc3-routes`."
  die(failures)
end

# The revision match above proves the table CLAIMS the right pin. It does not
# prove the table was produced by the current extractor: change the regexes or
# the normalizer without regenerating, and the revision still matches while the
# contents no longer reflect what the code would produce. Fingerprinting the
# generator closes that offline, with no bc3 checkout.
expected_fingerprint = N.generator_fingerprint
recorded_fingerprint = table.fetch('source')['generator_sha256']

if recorded_fingerprint.nil?
  failures << 'spec/bc3-routes.json predates generator fingerprinting. Run `make bc3-routes`.'
elsif recorded_fingerprint != expected_fingerprint
  failures << 'spec/bc3-routes.json was built by a different extractor than the one in the tree ' \
              "(recorded #{recorded_fingerprint[0, 12]}, current #{expected_fingerprint[0, 12]}). " \
              'The route table and the code that reads bc3 have diverged — run `make bc3-routes`.'
end
die(failures) unless failures.empty?

bc3_routes = table.fetch('routes')
if bc3_routes.length < MIN_BC3_ROUTES
  failures << "only #{bc3_routes.length} bc3 routes extracted (floor #{MIN_BC3_ROUTES}) — " \
              'the doc format probably changed and extraction is silently failing.'
end

openapi = JSON.parse(File.read(File.join(ROOT, 'openapi.json'), encoding: "UTF-8"))
sdk = []
openapi.fetch('paths').each do |path, ops|
  ops.each do |method, op|
    next unless N::METHODS.include?(method.upcase)
    sdk << { id: op['operationId'], method: method.upcase, path: path }
  end
end
if sdk.length < MIN_SDK_ROUTES
  failures << "only #{sdk.length} SDK routes read from openapi.json (floor #{MIN_SDK_ROUTES})."
end
die(failures) unless failures.empty?

# ------------------------------------------------------------------- allowlist

allow_path = ENV['BC3_ROUTE_ALLOWLIST'] || File.join(ROOT, 'spec', 'bc3-route-allowlist.yml')
allow = File.exist?(allow_path) ? (YAML.safe_load(File.read(allow_path, encoding: "UTF-8")) || {}) : {}
sdk_allow = allow['sdk_routes_absent_from_bc3_docs'] || []
bc3_allow = allow['bc3_routes_not_modeled'] || []
known_bad = allow['sdk_routes_known_defective'] || []
scope_aliases = allow['scope_aliases'] || []

# Known defects must stay attributable. An unattributed "we know" is just a
# waiver with better manners.
#
# This can only check the number is a number — issue STATE needs the network,
# and this gate is offline by construction (see header). scripts/check-known-
# defect-issues-open verifies the referenced issues are still open, as its own
# CI job; #588 auto-closed with nine live 404s pointing at it and this loop
# stayed green throughout, because "is an Integer" was the entire test.
known_bad.each do |e|
  next if e['issue'].is_a?(Integer)
  failures << "sdk_routes_known_defective entry #{e['method']} #{e['path']} has no numeric `issue:` — " \
              'a known defect without a tracking issue is an untracked defect.'
end

# Scope aliases assert that bc3 serves a flat spelling it only documents
# bucket-scoped. That is precisely the shape of four confirmed defects here, so
# prose is not enough: require a routes.rb citation, and require the entry to
# name where the flat form is proven reachable.
scope_aliases.each do |e|
  where = "scope_aliases entry #{e['method']} #{e['path']}"
  failures << "#{where} needs `routes_rb:` citing the line that draws the FLAT form." \
    unless e['routes_rb'].is_a?(String) && !e['routes_rb'].strip.empty?
  failures << "#{where} needs `api_test:` (a test/api path proving the flat route answers) or " \
              '`api_view:` (the app/views/api template it renders).' \
    unless [e['api_test'], e['api_view']].any? { |v| v.is_a?(String) && !v.strip.empty? }
end

# Direction 2 dispositions. If this gate claims to enforce "absorbed into the
# spec or registered", an entry cannot discharge that with free prose — it has to
# say which mechanism is tracking it.
VALID_DISPOSITIONS = %w[tracking_issue registry out_of_scope modeled_as].freeze

# `modeled_as` discharges an entry by naming the operation that already covers
# this resource+verb at bc3's other spelling. It is the only disposition that
# asserts something is DONE, so it is the only one that has to be provable — the
# other three merely say who owns the debt.
#
# Four things are checked, and the last two are the ones that matter.
#
#   1. SDK side: the operationId exists and carries the same method.
#   2. It sits at a different path — an identical one would have matched
#      sdk_exact already, which makes the entry stale rather than discharged.
#   3. bc3 side: bc3's own route table documents the substitute path. Without
#      this, `modeled_as` is just the ListForwards mistake with a schema — a
#      confident claim about a spelling bc3 never served.
#   4. The substitute addresses the SAME resource. Checks 1-3 alone accept any
#      unrelated same-verb operation: an early draft of this code happily let
#      ListGaugeNeedles and GetTimesheetEntry both discharge the gauge-needle
#      SHOW route, since both are real, bc3-documented GETs.
#
#      The rule is that the substitute's path must be a SUFFIX of the bc3 path,
#      compared as flattened segments. A flat spelling is the scoped one with a
#      leading scope removed, and nothing else — so a suffix is exactly the
#      shape being claimed. Flattening (splitting segments on `_`) is what makes
#      it survive bc3's renames across spellings: /gauge_needles/:id becomes
#      [gauge, needles, :id], which IS a suffix of [projects, :id, gauge,
#      needles, :id].
#
#      Suffix, not subset. Subset was the first version and it let
#      GetProjectTimesheet (/projects/:id/timesheet) discharge the RECORDING
#      timesheet route, because {projects, timesheet} does sit inside {projects,
#      recordings, timesheet}. But that drops `recordings/:id` from the MIDDLE,
#      which changes which timesheet you get. Dropping a leading scope is a
#      spelling; dropping an interior resource is a different endpoint.
#
# What this gate CANNOT check, and a reviewer therefore must.
#
# Every check above is about SHAPE: the operation exists, the verb matches, the
# path differs, bc3 documents it, and it is this route with a leading scope
# removed. None of them establishes the thing `modeled_as` actually claims —
# that the two spellings reach the SAME controller action. spec/bc3-routes.json
# is extracted from bc3's doc/api/sections/*.md and carries only `method`,
# `path`, `raw`, `sections` and `evidence`. There is no controller and no action
# in it, so no amount of cleverness here derives that fact; two routes can
# satisfy every check above and still be served by different controllers.
#
# So a fifth requirement is enforced as EVIDENCE rather than as a check: every
# `modeled_as` entry must carry a non-empty `routes_rb:`. Before approving a new
# one, verify by hand and record it there:
#
#   1. Both draws in bc3's config/routes.rb name the SAME controller action —
#      cite both line numbers, and the enclosing `resources` blocks, since a
#      draw's meaning is its nesting.
#   2. A bc3 API test covers the pair, ideally asserting the two spellings
#      return identical data — cite it by name and line.
#   3. Rule out the NEAR MISS, and say which one you rejected. The routes that
#      trip this are neighbours: config/routes.rb:740 draws
#      /projects/:id/timesheet five lines from :745's
#      /projects/:id/recordings/:id/timesheet, and they are different endpoints.
#      Requirement 1 is what catches that — a near miss fails it, because the
#      neighbouring draw reaches the same controller by a different route.
#
# Writing that down is the point. An unstated requirement is one nobody applies,
# and `modeled_as` is the only disposition here that asserts something is DONE.
by_id = sdk.group_by { |o| o[:id] }
# Named to avoid ending in `key`: gitleaks' generic-api-key rule reads
# `<name>key = <token>` as a credential assignment and fails the Secret Scanning job.
bc3_documented = bc3_routes.map { |r| N.key(r['method'], r['path']) }.to_set

# Path segments, rename-insensitive: split compound segments so gauge_needles
# compares equal to the nested gauge/needles.
def flat_segments(path)
  N.normalize(path).split('/').reject(&:empty?).flat_map { |s| s.split('_') }
end

validate_modeled_as = lambda do |e, where|
  # The unmechanizable half, demanded as a citation. Not `next`-guarded: a
  # missing citation and a bogus operationId are separate defects, and reporting
  # only the first hides the second behind a second run.
  failures << "#{where}: `modeled_as` needs `routes_rb:` naming BOTH draws and stating they name the " \
              'same controller action. spec/bc3-routes.json carries no controller data, so this gate ' \
              'cannot check it — the citation is the only record that anyone did.' \
    unless e['routes_rb'].is_a?(String) && !e['routes_rb'].strip.empty?

  opid = e['modeled_as']
  unless opid.is_a?(String) && !opid.strip.empty?
    failures << "#{where}: `modeled_as` must name an operationId."
    next
  end

  subs = by_id[opid]
  if subs.nil?
    failures << "#{where}: `modeled_as: #{opid}` names no operation in openapi.json."
    next
  end

  entry_key = N.key(e['method'], e['path'])
  match = subs.find { |o| o[:method] == e['method'].to_s.upcase }
  if match.nil?
    failures << "#{where}: `modeled_as: #{opid}` is #{subs.map { |o| o[:method] }.uniq.join('/')}, " \
                "not #{e['method']} — a different verb does not cover this route."
  elsif N.key(match[:method], match[:path]) == entry_key
    failures << "#{where}: `modeled_as: #{opid}` sits at this very path, so the route is " \
                'already matched directly — remove the entry.'
  elsif !bc3_documented.include?(N.key(match[:method], match[:path]))
    failures << "#{where}: `modeled_as: #{opid}` points at #{match[:method]} " \
                "#{N.normalize(match[:path])}, which bc3 does not document. Substituting a " \
                'spelling bc3 does not serve is the defect this gate exists to catch.'
  elsif flat_segments(match[:path]).last != flat_segments(e['path']).last
    failures << "#{where}: `modeled_as: #{opid}` is #{N.normalize(match[:path])}, which ends in " \
                "#{flat_segments(match[:path]).last.inspect} where this route ends in " \
                "#{flat_segments(e['path']).last.inspect} — the terminal segment has to match. " \
                'A collection cannot stand in for a member, and a different noun is a different ' \
                'resource whether or not both are collections.'
  else
    sub = flat_segments(match[:path])
    full = flat_segments(e['path'])
    unless full.last(sub.length) == sub
      failures << "#{where}: `modeled_as: #{opid}` is #{N.normalize(match[:path])}, which is not " \
                  "#{N.normalize(e['path'])} with a leading scope removed " \
                  "(#{sub.join('/')} vs #{full.join('/')}). Only a scope prefix may differ; " \
                  'anything else addresses a different resource.'
    end
  end
end

bc3_allow.each do |e|
  where = "bc3_routes_not_modeled entry #{e['method']} #{e['path']}"
  present = VALID_DISPOSITIONS.select { |k| e.key?(k) }
  if present.empty?
    failures << "#{where} has no disposition — needs exactly one of " \
                "#{VALID_DISPOSITIONS.join(', ')}."
  elsif present.length > 1
    failures << "#{where} has multiple dispositions (#{present.join(', ')}); pick one."
  else
    case present.first
    when 'tracking_issue'
      failures << "#{where}: `tracking_issue` must be a number." unless e['tracking_issue'].is_a?(Integer)
    when 'registry'
      path = e['registry'].to_s
      failures << "#{where}: `registry` must point at an existing spec/api-gaps/ entry (got #{path.inspect})." \
        unless path.start_with?('spec/api-gaps/') && File.exist?(File.join(ROOT, path))
    when 'out_of_scope'
      failures << "#{where}: `out_of_scope` must be a non-empty justification." \
        unless e['out_of_scope'].is_a?(String) && e['out_of_scope'].strip.length > 20
    when 'modeled_as'
      validate_modeled_as.call(e, where)
    end
  end
end

# Track which allowlist entries actually matched. An entry matching nothing is a
# hard error, not a shrug: a stale waiver is indistinguishable from a covered
# case at a glance, and check-bucket-flat-parity's lack of this check is what
# lets its waivers rot.
used = Set.new

# mode: :exact for anything describing an SDK route (a wrong spelling there is a
# 404), :loose for the bc3 -> SDK coverage ledger. See bc3_route_normalizer.rb.
def allowed?(list, used, method, path, mode: :exact)
  keyfn = mode == :exact ? N.method(:key) : N.method(:bucket_insensitive_key)
  want = keyfn.call(method, path)
  hit = list.find { |e| keyfn.call(e.fetch('method'), e.fetch('path')) == want }
  return false unless hit
  used << hit.object_id
  true
end

def find_entry(list, method, path, mode: :exact)
  keyfn = mode == :exact ? N.method(:key) : N.method(:bucket_insensitive_key)
  want = keyfn.call(method, path)
  list.find { |e| keyfn.call(e.fetch('method'), e.fetch('path')) == want }
end

# ------------------------------------------------- direction 1: SDK -> bc3 docs

# EXACT identity only. bucket_insensitive_key is deliberately absent here: an
# SDK route that only matches after collapsing /buckets/:id is a route bc3 may
# not serve at that spelling, which is a 404 for every caller. Proven scope
# aliases go in the evidence-bearing scope_aliases list instead.
bc3_exact = bc3_routes.map { |r| N.key(r['method'], r['path']) }.to_set

flagged = []

undocumented = sdk.reject do |o|
  next true if bc3_exact.include?(N.key(o[:method], o[:path]))
  next true if allowed?(scope_aliases, used, o[:method], o[:path])
  next true if allowed?(sdk_allow, used, o[:method], o[:path])
  if allowed?(known_bad, used, o[:method], o[:path])
    entry = find_entry(known_bad, o[:method], o[:path])
    flagged << "#{o[:id]} (#{o[:method]} #{N.normalize(o[:path])}) — known defect, see ##{entry['issue']}"
    next true
  end
  false
end

undocumented.sort_by { |o| o[:id].to_s }.each do |o|
  bucket_form = bc3_routes.find do |r|
    N.bucket_insensitive_key(r['method'], r['path']) == N.bucket_insensitive_key(o[:method], o[:path])
  end
  hint = if bucket_form
           " bc3 documents it only as #{bucket_form['path']} — if the flat form is really served, " \
           'add a scope_aliases entry citing a routes.rb line and an API test.'
         else
           ' Fix the route, or allowlist it with a reason.'
         end
  failures << "#{o[:id]}: SDK declares #{o[:method]} #{N.normalize(o[:path])}, " \
              "which bc3 does not document.#{hint}"
end

# ------------------------------------------------- direction 2: bc3 docs -> SDK
#
# Mechanizes the rule AGENTS.md already states and nothing enforced: a repin is
# valid exactly when every drift item is either absorbed into the spec or
# registered. Before this, advancing the pin required no triage at all.

sdk_exact = sdk.map { |o| N.key(o[:method], o[:path]) }.to_set
sdk_loose = sdk.map { |o| N.bucket_insensitive_key(o[:method], o[:path]) }.to_set

unmodeled = bc3_routes.reject do |r|
  sdk_exact.include?(N.key(r['method'], r['path'])) ||
    sdk_loose.include?(N.bucket_insensitive_key(r['method'], r['path'])) ||
    allowed?(bc3_allow, used, r['method'], r['path'], mode: :loose)
end

unmodeled.sort_by { |r| [r['sections'].join, r['path']] }.each do |r|
  failures << "bc3 documents #{r['method']} #{r['path']} (#{r['sections'].join(', ')}, " \
              "evidence: #{r['evidence'].join('+')}) with no SDK operation and no allowlist entry."
end

# --------------------------------------------------------- stale allowlist scan

(sdk_allow + bc3_allow + known_bad + scope_aliases).each do |e|
  next if used.include?(e.object_id)
  failures << "stale allowlist entry: #{e.fetch('method')} #{e.fetch('path')} " \
              "matches nothing — remove it (reason on file: #{e['reason']})."
end

die(failures) unless failures.empty?

marked = bc3_routes.count { |r| r['evidence'].include?('example-marker') }
puts "==> bc3 route parity OK: #{sdk.length} SDK routes vs #{bc3_routes.length} bc3 routes " \
     "(#{marked} live-marker-backed) at bc3 #{pinned[0, 10]}."
puts "    Direction 1 is EXACT (a wrong spelling is a 404): " \
     "#{scope_aliases.length} evidenced scope aliases, #{sdk_allow.length} documented-elsewhere waivers."
by_disposition = VALID_DISPOSITIONS
                 .map { |k| [k, bc3_allow.count { |e| e.key?(k) }] }
                 .reject { |_, n| n.zero? }
                 .map { |k, n| "#{n} #{k}" }
puts "    Direction 2 collapses bucket scoping (coverage ledger): " \
     "#{bc3_allow.length} dispositions (#{by_disposition.join(', ')})."

# Loud, every run. These are live 404s in shipped consumers; the gate is green
# only because the fixes are breaking and queued, not because they are fine.
unless flagged.empty?
  puts
  puts "==> #{flagged.length} KNOWN-DEFECTIVE route#{flagged.length == 1 ? '' : 's'} " \
       'still shipping (green only because the fix is breaking and queued):'
  flagged.sort.each { |f| puts "      #{f}" }
end
