#!/usr/bin/env bash
#
# check-runner-test-reachability — assert every conformance-runner test file is
# actually executed by something.
#
# #572: `conformance-runner-tests` ran the Python and Ruby runner suites by
# NAMING one file each (`test_delay_gaps.py`, `delay_gaps_test.rb`), and
# .github/workflows/test.yml named the same two a second time. The two
# replay-runner suites — conformance/runner/python/test_replay_runner.py and
# conformance/runner/ruby/replay_runner_test.rb — matched neither name and were
# therefore executed by nothing, for months, in a fully green repo. That is the
# exact defect `conformance-runner-tests` was created to close (assertion code
# nothing exercises), reproduced one level up in the build.
#
# Two teeth, because the gap has two ways back in:
#
#   (1) ENUMERATION BAN. No `conformance-runner-tests-*` recipe, and nothing in
#       the CI workflow, may name an individual runner test file. Discovery must
#       be the only selector, so adding a test file is sufficient to run it.
#       This is the tooth that fails against pre-fix main.
#
#   (2) DISCOVERABILITY. Every file that CONTAINS tests (detected by content —
#       a TestCase subclass, a Minitest::Test, a `func TestX`, a vitest import,
#       an `@Test`, an XCTestCase) must sit where its language's discovery
#       looks: matching the discovery glob for Go/Python/Ruby/TypeScript, and
#       under the test source root for Kotlin/Swift (Gradle and SwiftPM discover
#       by directory, not by filename). This is the tooth a misnamed or
#       misplaced future file trips.
#
#       NAME IS NOT ENOUGH — reachability is name AND placement. Each glob
#       language declares a discovery SCOPE:
#
#         recursive  discovery walks subdirectories, so only the name decides.
#                    Go (`go test ./...`), pytest and vitest are recursive by
#                    their own toolchains' rules.
#         toplevel   discovery expands a glob in the language directory itself,
#                    so a correctly-named file one directory down is run by
#                    nothing and must be reported.
#
#       Ruby is the arm this distinction exists for. Its discovery is not a
#       toolchain's, it is hand-rolled in the Makefile, so this check DERIVES
#       Ruby's scope from that recipe (ruby_discovery_scope) instead of assuming
#       one. An earlier revision assumed recursive while the recipe ran
#       `for f in *_test.rb` — a top-level glob — and so certified
#       conformance/runner/ruby/nested/probe_test.rb as "matched by *_test.rb"
#       while `make conformance-runner-tests-ruby` never opened it. A
#       guaranteed-failing file was reachable-by-this-check and executed by
#       nothing: exactly the #572 shape, inside the #572 gate. Deriving the
#       scope is what keeps the check and the recipe from disagreeing again.
#
# All are fail-closed: a language whose content scan finds ZERO test files is a
# failure, not a vacuous pass — an empty result means the detector broke, and a
# detector that matches nothing cannot report anything unreachable. Likewise a
# Ruby recipe whose scope cannot be determined is a failure, not a default.
#
# The enumeration ban compares against the basenames tooth (2) actually found on
# disk rather than a "looks like a test filename" regex, so the discovery globs
# the recipes legitimately contain (`*_test.rb`) are not themselves reported.
#
# Roots are overridable via REPO_ROOT so --self-test can point the whole check
# at a synthetic tree and prove each tooth fires — for a misnamed file, for a
# misplaced one under a top-level Ruby recipe, for the test forms the CONTENT
# DETECTOR must not miss (an unsuffixed `func Example()`, a class-based pytest
# suite, a Jupiter @ParameterizedTest, a parameterized @Test), for locations a
# toolchain silently skips, and for a CI workflow that stops invoking a suite.
# Every loud case is paired with a QUIET one — a support module the toolchain
# loads on its own, a filename convention it discovers, a placement it really
# does reach — so no loud case can be satisfied by over-matching, which is the
# failure mode that gets a gate switched off.
#
# The content detector is this check's weakest surface, because a miss there is
# SILENT: the arm's `found` count stays nonzero thanks to the other files, so it
# prints `ok` rather than reporting anything. Every detector gap found so far has
# a committed self-test case; add one with any future widening.
#
# Exit non-zero on any violation. Wired into `make check` and CI (spec-gates).
set -uo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

SELF_TEST=0
if [[ "${1:-}" == "--self-test" ]]; then
    SELF_TEST=1
    shift
fi

REPO_ROOT="${REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$REPO_ROOT" || exit 2

# Byte-wise collation so globs and sorts order identically everywhere.
export LC_ALL=C

# Extended globs, so a discovery pattern can be written the way its toolchain
# documents it. vitest's default include is `**/*.{test,spec}.?(c|m)[jt]s?(x)`;
# with extglob that transcribes to one pattern instead of the 24 it expands to,
# and a pattern that is a transcription can be checked against the docs.
shopt -s extglob

fail=0
pass=0
# Basenames of every test-bearing file found on disk, for the enumeration ban.
TEST_BASENAMES=()

# Source files only. Toolchain scratch (.venv, node_modules, SwiftPM/Gradle
# build trees) is full of third-party test files that no discovery of OURS is
# expected to reach, and none of it is committed.
#
# `build` is deliberately NOT here, even though Gradle's output directory is
# called that. Pruning it globally silently outranked a per-arm exclusion:
# `build` is in pytest's norecursedirs default, so the Python arm is supposed to
# REPORT conformance/runner/python/build/test_stranded.py as collected-by-
# nothing — and instead find never handed it over, the arm counted only the two
# real files, and the check exited 0. A global prune that hides a file from the
# arm whose job is to report it is not a prune, it is a blind spot. Gradle's own
# tree is unaffected: the Kotlin arm scans kotlin/conformance/src, and Gradle
# writes to kotlin/conformance/build, outside it. SwiftPM's .build stays pruned,
# and every build/ that exists under a scan root today sits inside node_modules,
# which is pruned before find descends into it.
PRUNE=(-name .venv -o -name node_modules -o -name vendor
       -o -name .build -o -name .gradle -o -name .pytest_cache -o -name .git)

# find_sources <dir> <ext> — committed *.<ext> under <dir>, vendored trees pruned.
#
# <ext> may be a `|`-separated list. The scanned extension set has to be the one
# the toolchain COLLECTS, not the one the runner happens to use today: a file
# with an unscanned extension is invisible to the content detector, the arm's
# `found` count stays nonzero thanks to the others, and it prints `ok` — the
# silent direction. A `stranded.tsx` importing vitest was exactly that hole
# while this scanned `ts` alone.
find_sources() {
    local dir="$1" ext="$2"
    local names=() e first=1
    local IFS='|'
    # shellcheck disable=SC2206  # deliberate split on the ext separator
    local exts=($ext)
    IFS=' '
    for e in "${exts[@]}"; do
        if [[ "$first" -eq 1 ]]; then
            names+=(-name "*.$e")
            first=0
        else
            names+=(-o -name "*.$e")
        fi
    done
    find "$dir" \( "${PRUNE[@]}" \) -prune -o -type f \( "${names[@]}" \) -print 2>/dev/null | sort
}

note_fail() {
    fail=$((fail + 1))
    echo "  FAIL: $1"
    shift
    local line
    for line in "$@"; do
        echo "        $line"
    done
}

# ---------------------------------------------------------------------------
# Makefile recipe extraction. Used by tooth (1) (the enumeration ban) and by
# ruby_discovery_scope, which is consulted by tooth (2) — hence defined up here.
#
# make_recipes <target-prefix-pattern>: the target line plus the indented and
# continued lines under it, up to the next unindented line.
# ---------------------------------------------------------------------------
make_recipes() {
    [[ -f Makefile ]] || return 0
    awk -v pat="$1" '
        $0 ~ pat                                  { inrecipe = 1; print; next }
        inrecipe && /^[\t ]/                      { print; next }
        inrecipe && /^(ifdef|ifndef|else|endif)/  { print; next }
        inrecipe                                  { inrecipe = 0 }
    ' Makefile
}

# ruby_discovery_scope — read the Ruby runner-test recipe and report the scope
# its discovery actually has: `recursive`, `toplevel`, or `unknown`.
#
# Ruby is the only glob language whose discovery is written here rather than
# supplied by a test toolchain, so it is the only one where this check could
# drift from what really runs. Unrecognized shapes report `unknown` and fail;
# guessing is how the hole this function closes was opened.
ruby_discovery_scope() {
    local body
    # Join backslash continuations first: the recipe is one shell command split
    # over several Makefile lines, and a line-wise match would read `find` and
    # its `-name '*_test.rb'` as unrelated. Match what the shell sees.
    body="$(make_recipes '^conformance-runner-tests-ruby:' | awk '
        { line = line $0 }
        sub(/\\$/, "", line) { next }
        { print line; line = "" }
        END { if (line != "") print line }
    ')"
    if [[ -z "$body" ]]; then
        echo unknown
    elif grep -Eq "find[[:space:]].*-name[[:space:]]+['\"]?\*_test\.rb" <<<"$body"; then
        # `find ... -name '*_test.rb'` walks subdirectories.
        echo recursive
    elif grep -Eq "for[[:space:]]+[[:alnum:]_]+[[:space:]]+in[[:space:]]+\*_test\.rb" <<<"$body"; then
        # A bare `for f in *_test.rb` expands in the language directory only.
        echo toplevel
    else
        echo unknown
    fi
}

# swift_test_target_path — read conformance/runner/swift/Package.swift and
# report the SwiftPM test target's declared `path`, relative to the package.
#
# Derived rather than assumed, for the same reason ruby_discovery_scope is:
# SwiftPM compiles the testTarget's `path` and nothing else, so `Tests/` is the
# convention, not the contract. An unreadable manifest reports `unknown` and
# fails — a guessed test root is how the Ruby hole opened.
swift_test_target_path() {
    local manifest="$1"
    [[ -f "$manifest" ]] || { echo unknown; return; }
    # From `.testTarget(` to that block's first `path:` string literal.
    awk '
        index($0, ".testTarget(") > 0 { intt = 1 }
        intt && match($0, /path:[[:space:]]*"[^"]+"/) {
            s = substr($0, RSTART, RLENGTH)
            match(s, /"[^"]+"/)
            print substr(s, RSTART + 1, RLENGTH - 2)
            exit
        }
    ' "$manifest" | head -1 | grep . || echo unknown
}

# ---------------------------------------------------------------------------
# Tooth (2): every test-bearing file sits where discovery finds it.
#
# check_glob_discovery <label> <ext> <dir> <content-marker-regex> <scope> <glob>...
#   A file under <dir> whose contents match <content-marker-regex> must be
#   reachable by <dir>'s discovery, which means BOTH:
#     - its basename matches at least one <glob>, and
#     - under scope `toplevel`, it sits directly in <dir> — a nested file is
#       correctly named and still run by nothing.
#   Under scope `recursive` the depth is irrelevant and only the name decides.
#   Any other <scope> value is a hard failure: an undetermined scope must not
#   silently fall back to the permissive branch.
#
#   ORDER MATTERS. The content scan runs BEFORE the scope is judged, because
#   the scan is what populates TEST_BASENAMES, and tooth (1) reports only names
#   it has seen. Bailing out on an unreadable scope first meant that against a
#   Makefile whose Ruby recipe NAMES a file — the very state this check
#   exists to reject — Ruby's scope read as `unknown`, the arm returned before
#   collecting anything, and the enumeration ban then had no `delay_gaps_test.rb`
#   to report. The run still failed, so nothing passed silently, but it named
#   half the enumeration. A check that fires must fire completely.
# ---------------------------------------------------------------------------
check_glob_discovery() {
    local label="$1" ext="$2" dir="$3" marker="$4" scope="$5" ignore_re="$6"
    shift 6
    local globs=("$@")

    if [[ ! -d "$dir" ]]; then
        note_fail "$label: directory $dir does not exist" \
            "the runner layout moved — update this check deliberately"
        return
    fi

    local found=0 misnamed=() nested=() ignored=()
    local file base rel matched glob
    while IFS= read -r file; do
        grep -Eq "$marker" "$file" || continue
        base="$(basename "$file")"
        TEST_BASENAMES+=("$base")
        rel="${file#"$dir"/}"
        # Toolchain-ignored locations. `recursive` means "walks subdirectories",
        # not "walks every subdirectory": `go help packages` says the go tool
        # ignores directories and files beginning with "." or "_", and any
        # directory named testdata. A _test.go under one of those is matched by
        # the glob, reached by find, and compiled by nothing.
        if [[ -n "$ignore_re" ]] && grep -Eq "$ignore_re" <<<"$rel"; then
            ignored+=("$file")
            continue
        fi
        found=$((found + 1))
        matched=0
        for glob in "${globs[@]}"; do
            # shellcheck disable=SC2053  # deliberate glob match, not a string compare
            if [[ "$base" == $glob ]]; then
                matched=1
                break
            fi
        done
        if [[ "$matched" -eq 0 ]]; then
            misnamed+=("$file")
            continue
        fi
        # Name is fine. Record the depth; whether it MATTERS is the scope's call.
        if [[ "$rel" == */* ]]; then
            nested+=("$file")
        fi
    done < <(find_sources "$dir" "$ext")

    if [[ "$found" -eq 0 ]]; then
        note_fail "$label: no test-bearing files found under $dir" \
            "the content detector matched nothing — a broken detector, not an empty suite"
        return
    fi

    if [[ "$scope" != recursive && "$scope" != toplevel ]]; then
        note_fail "$label: discovery scope is '$scope', not recursive or toplevel" \
            "the recipe's discovery could not be read, so placement cannot be judged" \
            "fix the recipe or teach ruby_discovery_scope its shape — do not assume"
        return
    fi

    # Guarded on the count, not just on the scope: bash 3.2 — still /bin/bash on
    # macOS — treats "${empty[@]}" as an unbound variable under `set -u` and
    # aborts the script. Every other expansion here is already inside a
    # `-gt 0` guard for the same reason.
    local misplaced=()
    if [[ "$scope" == toplevel && "${#nested[@]}" -gt 0 ]]; then
        misplaced=("${nested[@]}")
    fi

    local clean=1
    if [[ "${#misnamed[@]}" -gt 0 ]]; then
        note_fail "$label: test file(s) matched by no discovery glob (${globs[*]})" \
            "${misnamed[@]}"
        clean=0
    fi
    if [[ "${#ignored[@]}" -gt 0 ]]; then
        note_fail "$label: test file(s) in a location the toolchain skips" \
            "${ignored[@]}" \
            "the name matches a discovery glob and find reaches the file, but" \
            "$label's own discovery excludes that location — the go tool ignores" \
            "'.'/'_' names and testdata dirs (go help packages), pytest skips its" \
            "norecursedirs default, vitest its default exclude — so it is compiled" \
            "or collected by nothing. Move it, or rename the directory."
        clean=0
    fi
    if [[ "${#misplaced[@]}" -gt 0 ]]; then
        note_fail "$label: test file(s) nested below $dir, which discovery does not enter" \
            "${misplaced[@]}" \
            "$label discovery is a top-level glob — a correctly-named file one" \
            "directory down is executed by nothing (#572). Move it up, or make" \
            "the recipe recurse."
        clean=0
    fi
    [[ "$clean" -eq 1 ]] || return

    pass=$((pass + 1))
    echo "  ok: $label — $found test file(s), all matched by ${globs[*]} ($scope discovery)"
}

# check_go_build_constraints <dir> — a runner test the go tool may EXCLUDE from
# the build is not reachable either, however well it is named and placed.
#
# `go help build` gives two mechanisms: a `//go:build` line, and an implicit
# constraint from the filename — a source file ending in `_GOOS.go`,
# `_GOARCH.go` or `_GOOS_GOARCH.go` (the suffix sits before `_test`, so
# `probe_windows_test.go`) is built only for that target. Either way
# `go test ./...` on the CI runner compiles nothing in the file, while the glob
# matches it, find reaches it, and the arm above counts it as reachable.
#
# This does NOT try to decide whether a constraint is satisfied — that would
# mean modelling GOOS/GOARCH/tags for every job that runs the suite, and
# guessing is how the Ruby scope hole opened. Any constraint on a runner test is
# reported: reachability cannot be certified, so it must be stated deliberately.
# There are none today, and a suite that genuinely needs one belongs behind an
# explicit exception here rather than behind a silent skip.
GO_TARGET_SUFFIX='(android|darwin|dragonfly|freebsd|hurd|illumos|ios|js|linux|nacl|netbsd|openbsd|plan9|solaris|wasip1|windows|zos|386|amd64|arm|arm64|loong64|mips|mips64|mips64le|mipsle|ppc64|ppc64le|riscv64|s390x|sparc64|wasm)'
check_go_build_constraints() {
    local dir="$1" marker="$2"
    [[ -d "$dir" ]] || return 0

    local constrained=() file base
    while IFS= read -r file; do
        grep -Eq "$marker" "$file" || continue
        base="$(basename "$file")"
        if grep -Eq '^//[[:space:]]*go:build|^//[[:space:]]*\+build' "$file"; then
            constrained+=("$file (//go:build constraint)")
        elif [[ "$base" =~ _${GO_TARGET_SUFFIX}(_${GO_TARGET_SUFFIX})?(_test)?\.go$ ]]; then
            constrained+=("$file (implicit constraint from the filename)")
        fi
    done < <(find_sources "$dir" go)

    if [[ "${#constrained[@]}" -gt 0 ]]; then
        note_fail "Go: test file(s) the go tool may exclude from the build" \
            "${constrained[@]}" \
            "a build constraint decides whether \`go test ./...\` compiles the file" \
            "at all (go help build), so a constrained runner test can be correctly" \
            "named, correctly placed, and still assert nothing on the platform CI" \
            "runs. Drop the constraint, or state the exception here."
        return
    fi
    pass=$((pass + 1))
    echo "  ok: Go — no runner test hides behind a build constraint"
}

# check_dir_discovery <label> <ext> <test-root> <scan-root> <content-marker-regex>
#   Gradle's `test` task and SwiftPM's `swift test` discover by DIRECTORY, so
#   reachability is "is it under the COMPILED test directory?".
#
#   <scan-root> is the whole module, not just its production sources, and
#   anything test-bearing under it that is NOT under <test-root> is stranded.
#   Scanning only `Sources/` was too narrow in the same way `Tests/` was too
#   broad: SwiftPM compiles exactly the testTarget's declared `path`, so
#   Tests/ReplayTests/ReplayTests.swift — a sibling of the declared target,
#   plainly "under Tests" — is compiled by nothing, and the declared target's
#   own files keep `found` nonzero so the arm still printed `ok`. Gradle is the
#   same story one directory up: its test source set is src/test/kotlin, not
#   src/test.
check_dir_discovery() {
    local label="$1" ext="$2" test_root="$3" scan_root="$4" marker="$5"

    if [[ ! -d "$test_root" ]]; then
        note_fail "$label: test root $test_root does not exist" \
            "the runner layout moved — update this check deliberately"
        return
    fi

    local found=0 stranded=() file
    while IFS= read -r file; do
        grep -Eq "$marker" "$file" || continue
        if [[ "$file" == "$test_root"/* ]]; then
            found=$((found + 1))
            TEST_BASENAMES+=("$(basename "$file")")
        else
            stranded+=("$file")
        fi
    done < <(find_sources "$scan_root" "$ext")

    if [[ "$found" -eq 0 ]]; then
        note_fail "$label: no test-bearing files found under $test_root" \
            "the content detector matched nothing — a broken detector, not an empty suite"
        return
    fi

    if [[ "${#stranded[@]}" -gt 0 ]]; then
        note_fail "$label: test file(s) outside the compiled test directory ($test_root)" \
            "${stranded[@]}" \
            "$label discovery compiles $test_root and nothing else — a test beside" \
            "it, even under the same Tests/ or src/test/ parent, is run by nothing."
        return
    fi

    pass=$((pass + 1))
    echo "  ok: $label — $found test file(s), all under $test_root"
}

# ---------------------------------------------------------------------------
# drop_disabled_workflow_blocks — remove steps and jobs that a statically false
# `if:` turns off, so an invocation check reads only what CI would run.
#
# A step carrying `if: ${{ false }}` is skipped by GitHub Actions, but its
# `run: make conformance-runner-tests-go` is still a line in the file, so a
# line-wise grep reported the Go suite as invoked while CI ran none of it.
# Disabling a step is the natural way to "temporarily" park a suite, which makes
# it the natural way to reopen #572.
#
# Two ways a condition disables a step, and no third:
#
#   - it is LITERALLY false: `if: false` or `if: ${{ false }}`.
#   - it pins a matrix value the job's matrix does not offer. This workflow runs
#     the Ruby suite under `if: matrix.ruby == '3.3'`, so dropping '3.3' from
#     `matrix.ruby` — an ordinary thing to do when supported runtimes move on —
#     leaves the step skipped on every leg with the step itself untouched. The
#     literal value has to appear in the job's own `strategy:` block; a job with
#     no matrix at all cannot satisfy `matrix.x == 'v'` either.
#
# Everything else is left alone. Expressions are not evaluated, `!=` is not
# reasoned about, and a `matrix.ruby == '3.3'` whose value IS in the matrix
# still counts — a check that treated any `if:` as disqualifying would fail the
# real workflow. Self-test 25 pins the quiet side, 23/24/30/31 the loud one.
#
# Two passes, jobs then steps, because a job block contains step blocks and one
# buffer cannot be both. A job-level `if:` is the one that appears before the
# job's `steps:` key.
# ---------------------------------------------------------------------------
drop_disabled_workflow_blocks() {
    awk '
        function false_if(s) {
            return s ~ /^[[:space:]]*if:[[:space:]]*(\$\{\{[[:space:]]*)?false([[:space:]]*\}\})?[[:space:]]*$/
        }
        function indent(s,   n) { n = match(s, /[^ ]/); return n ? n - 1 : -1 }
        function flush(   i) {
            if (!disabled) for (i = 1; i <= n; i++) print buf[i]
            n = 0; disabled = 0; injob = 0; seensteps = 0
        }
        /^jobs:[[:space:]]*$/ { print; injobs = 1; jobind = -1; next }
        {
            if (!injobs) { print; next }
            if ($0 ~ /^[[:space:]]*$/) { if (injob) buf[++n] = $0; else print; next }
            ind = indent($0)
            if (jobind < 0) jobind = ind
            if (ind <= jobind) {
                if (injob) flush()
                if (ind < jobind) { injobs = 0; print; next }
                injob = 1; n = 0; disabled = 0; seensteps = 0
                buf[++n] = $0
                next
            }
            if (injob) {
                if ($0 ~ /^[[:space:]]*steps:[[:space:]]*$/) seensteps = 1
                else if (!seensteps && false_if($0)) disabled = 1
                buf[++n] = $0
                next
            }
            print
        }
        END { if (injob) flush() }
    ' | awk '
        function false_if(s) {
            return s ~ /^[[:space:]]*(-[[:space:]]+)?if:[[:space:]]*(\$\{\{[[:space:]]*)?false([[:space:]]*\}\})?[[:space:]]*$/
        }
        # The matrix value an `if: matrix.<key> == <value>` pins, or "".
        function pinned_value(s,   v) {
            if (s !~ /^[[:space:]]*(-[[:space:]]+)?if:.*matrix\.[A-Za-z0-9_]+[[:space:]]*==/) return ""
            v = s
            sub(/^.*==[[:space:]]*/, "", v)
            sub(/[[:space:]]*\}\}.*$/, "", v)
            gsub(/^[[:space:]]*['"'"'"]|['"'"'"][[:space:]]*$/, "", v)
            sub(/[[:space:]]*$/, "", v)
            return v
        }
        function offered(v,   re) {
            re = "(^|[^A-Za-z0-9_.-])" v "([^A-Za-z0-9_.-]|$)"
            return strat ~ re
        }
        function indent(s,   n) { n = match(s, /[^ ]/); return n ? n - 1 : -1 }
        function flush(   i) {
            if (!disabled) for (i = 1; i <= n; i++) print buf[i]
            n = 0; disabled = 0; instep = 0
        }
        {
            if ($0 ~ /^[[:space:]]*$/) { if (instep) buf[++n] = $0; else print; next }
            ind = indent($0)
            # Track the enclosing job so its matrix is known before its steps
            # are judged. A job key sits at the shallowest indent under `jobs:`.
            if ($0 ~ /^jobs:[[:space:]]*$/) { injobs = 1; jobind = -1 }
            else if (injobs) {
                if (jobind < 0) jobind = ind
                if (ind <= jobind) { if (instep) flush(); strat = ""; instrat = 0 }
                if (instrat && ind <= stratind) instrat = 0
                if (instrat) strat = strat "\n" $0
                if ($0 ~ /^[[:space:]]*strategy:[[:space:]]*$/) { instrat = 1; stratind = ind }
            }
            # A dash at or left of the current item opens a new one; a deeper
            # dash is a nested list INSIDE this step (a `with:` value, say) and
            # must not split it, or an `if:` above would stop guarding the
            # `run:` below.
            if ($0 ~ /^[[:space:]]*-[[:space:]]/ && (!instep || ind <= dashind)) {
                if (instep) flush()
                instep = 1; dashind = ind; n = 0; disabled = 0
                buf[++n] = $0
                if (false_if($0)) disabled = 1
                else { pv = pinned_value($0); if (pv != "" && !offered(pv)) disabled = 1 }
                next
            }
            if (instep) {
                if (ind > dashind) {
                    buf[++n] = $0
                    if (false_if($0)) disabled = 1
                    else { pv = pinned_value($0); if (pv != "" && !offered(pv)) disabled = 1 }
                    next
                }
                flush()
            }
            print
        }
        END { if (instep) flush() }
    '
}

# ---------------------------------------------------------------------------
# Tooth (1): no recipe names an individual test file.
# ---------------------------------------------------------------------------
check_no_enumeration() {
    local label="$1" src="$2"
    local base hits=()
    # An empty basename list means every tooth-(2) arm bailed out, which is
    # already several loud failures — but expanding it unguarded would abort the
    # whole script on bash 3.2 under `set -u` before those failures print.
    if [[ "${#TEST_BASENAMES[@]}" -eq 0 ]]; then
        note_fail "$label: no test basenames were collected, so enumeration cannot be judged" \
            "every per-language check failed before finding a file — fix those first"
        return
    fi
    for base in "${TEST_BASENAMES[@]}"; do
        grep -Fq -- "$base" <<<"$src" && hits+=("$base")
    done
    if [[ "${#hits[@]}" -gt 0 ]]; then
        note_fail "$label names individual test file(s) — discovery must be the only selector" \
            "${hits[@]}" \
            "a suite that does not match the named file is executed by nothing (#572)"
        return
    fi
    pass=$((pass + 1))
    echo "  ok: $label enumerates no test file"
}

echo "==> Checking conformance-runner test reachability"

# --- Tooth 2, per language --------------------------------------------------
# Go, Python and TypeScript are `recursive` on their toolchains' own authority:
# `go test ./...` walks the package tree, pytest recurses from its rootdir, and
# vitest's default include is `**/*.{test,spec}.?(c|m)[jt]s?(x)`. Ruby's scope is
# read back out of the Makefile, because Ruby's discovery is written there.
RUBY_SCOPE="$(ruby_discovery_scope)"

GO_TEST_MARKER='^func (Test|Benchmark|Fuzz|Example)[^a-z]'

# Go's rule is "the prefix, then a character that is not a lowercase letter" —
# `go help test`: TestXxx/BenchmarkXxx/FuzzXxx where Xxx does not start with a
# lowercase letter, and Example with no suffix at all. `[[:upper:]]` demanded a
# suffix AND demanded it be a letter, so `func Example()`, `func Test(` and
# `func Test_helper(` — all of which `go test` runs — were invisible to the
# detector. Invisible is the dangerous direction here: an undetected file is not
# reported as unreachable, and the other Go test files keep `found` nonzero, so
# the arm still prints `ok`. `[^a-z]` is Go's rule spelled directly.
# The ignore pattern is Go's own: `go help packages` — "Directory and file
# names that begin with '.' or '_' are ignored by the go tool, as are
# directories named testdata".
check_glob_discovery "Go" go conformance/runner/go \
    "$GO_TEST_MARKER" recursive \
    '(^|/)[._]|(^|/)testdata(/|$)' '*_test.go'

# Name and placement are not the whole of Go reachability — a build constraint
# can exclude a correctly-named, correctly-placed file from the build entirely.
check_go_build_constraints conformance/runner/go "$GO_TEST_MARKER"

# The ignore pattern is pytest's `norecursedirs` default, which `pytest --help`
# gives as `*.egg .* _darcs build CVS dist node_modules venv {arch}`: a
# correctly-named test under dist/ or venv/ is matched by the glob and collected
# by nothing.
#
# The marker keys on what pytest COLLECTS, not on what a file imports. pytest
# collects `test*` FUNCTIONS at module level and `test*` METHODS of `Test*`
# classes, and a class-based suite need import nothing at all:
#
#     class TestStranded:
#         def test_failure(self): assert False
#
# has no `import pytest`, no `unittest`, and its `def test` is INDENTED, so an
# anchored `^def test_` never saw it. One leading-whitespace-tolerant `def test`
# alternative covers both depths, and takes `async def` with it — asyncio suites
# declare their tests that way. Matching on the class NAME instead would be
# wrong in the other direction: runner.py declares TestCase/TestResult/
# TestRunner/TestTracker as its own plumbing, and flagging those would be a
# false failure.
#
# IMPORTING pytest is not declaring a test, and counting it as one made this arm
# reject the one module pytest is guaranteed to load. A conftest.py that imports
# pytest to define fixtures matches NEITHER collection glob, so `^import pytest`
# reported as unreachable a file pytest imports automatically for every
# directory it collects (pytest docs, "Fixtures: sharing across modules"). The
# same went for any shared helper that imports the framework without declaring
# anything runnable. Support modules are reachable by construction.
#
# Dropping that marker is not a weakening, because the converse still fails:
# pytest LOADS conftest.py but does not COLLECT from it — its name matches no
# `python_files` pattern — so a `def test_…` written there is executed by
# nothing. That file is caught by the `def test` alternative, matches no glob,
# and is reported. Self-tests 14 and 15 pin both directions.
#
# `^from unittest` is narrowed to imports that actually bring in TestCase, for
# the same reason: `from unittest import mock` and `from unittest.mock import
# patch` are helper imports, not suites, and the bare anchor flagged every
# module that used them. The name has to appear in the import itself, not in a
# trailing comment — hence `[^#]*` rather than `.*`.
check_glob_discovery "Python" py conformance/runner/python \
    'unittest\.TestCase|^from unittest[[:alnum:]._]* import [^#]*TestCase|^[[:space:]]*(async[[:space:]]+)?def test' \
    recursive '(^|/)(\.[^/]*|[^/]*\.egg|_darcs|build|CVS|dist|node_modules|venv|\{arch\})/' \
    'test_*.py' '*_test.py'

# Declarations, not the framework require — the same rule the Python arm follows,
# for the same reason. `require "minitest/autorun"` in a conventional
# test_helper.rb, required BY the suites rather than discovered independently,
# matches no `*_test.rb` glob, so treating the require as a suite failed the
# build over a support file that declares nothing runnable.
#
# A `Minitest::Test` subclass or a `def test_` still counts wherever it sits, so
# a helper that declares real tests is still reported. That direction is
# deliberately kept loud: minitest/autorun runs every test class LOADED into the
# process, so whether such a declaration executes depends on some *_test.rb
# requiring the helper — an edge this check cannot see and will not assume.
check_glob_discovery "Ruby" rb conformance/runner/ruby \
    'Minitest::(Test|Spec)|^[[:space:]]*def test_|^[[:space:]]*(describe|it)[[:space:]]+["'"'"']' \
    "$RUBY_SCOPE" '' '*_test.rb'

# Quote-agnostic: `from 'vitest'` is the same import and the same discovery.
#
# BOTH of vitest's filename conventions are accepted, because both are run. CI
# invokes an UNCONFIGURED `vitest run` with conformance/runner/typescript as its
# working directory, and there is no vitest config there — the SDK's own
# typescript/vitest.config.ts belongs to a different root and does not apply. So
# the selector is vitest's default include, `**/*.{test,spec}.?(c|m)[jt]s?(x)`
# (`defaultInclude`, vitest 4.1.10), under which foo.spec.ts is collected
# exactly like foo.test.ts. Accepting only `*.test.ts` reported a file vitest
# does run — the false-positive direction, and the direction that gets a gate
# switched off by the next person it inconveniences.
#
# The SCAN is every extension that include can match, not the `.ts` the runner
# happens to use today. Scanning `ts` alone made a `stranded.tsx` importing
# vitest invisible: unscanned means undetected, undetected means unreported, and
# the six .ts suites kept `found` nonzero so the arm printed `ok` over it. The
# glob is the documented include transcribed with extglob rather than expanded
# by hand, so it can be diffed against the docs.
#
# The ignore pattern is vitest's default EXCLUDE — node_modules, dist, cypress
# and the dot-dirs. tsconfig.json here declares `"outDir": "dist"`, so emitted
# `*.test.js` under dist/ is a real possibility, and vitest collects none of it.
VITEST_EXTS='ts|tsx|mts|mtsx|cts|ctsx|js|jsx|mjs|mjsx|cjs|cjsx'
check_glob_discovery "TypeScript" "$VITEST_EXTS" conformance/runner/typescript \
    "from ['\"]vitest['\"]" recursive \
    '(^|/)(node_modules|dist|cypress|\.idea|\.git|\.cache|\.output|\.temp)/' \
    '*.@(test|spec).?(c|m)@(j|t)s?(x)'

# Gradle's Kotlin test source set is src/test/kotlin, NOT src/test — the whole
# module is scanned so a .kt under src/test/anything-else is reported.
#
# The annotation may carry arguments: JUnit 4's `@Test(expected = …)`, and
# Swift Testing's `@Test("display name")` / `@Test(arguments: …)`. Requiring
# whitespace-or-EOL after `@Test` made every parameterized form invisible,
# which is the silent direction — the arm keeps printing `ok`.
#
# And `@Test` is not JUnit Jupiter's only test-declaring annotation. This module
# has `testImplementation(libs.junit.jupiter)` and `useJUnitPlatform()`, so
# @ParameterizedTest, @RepeatedTest, @TestFactory and @TestTemplate all declare
# runnable tests. Matching the literal `@Test` saw none of them.
KOTLIN_TEST_ANNOTATION='^[[:space:]]*@(Test|ParameterizedTest|RepeatedTest|TestFactory|TestTemplate)([[:space:](]|$)'
check_dir_discovery "Kotlin" kt \
    kotlin/conformance/src/test/kotlin kotlin/conformance/src \
    "$KOTLIN_TEST_ANNOTATION"

SWIFT_PKG=conformance/runner/swift
SWIFT_TEST_PATH="$(swift_test_target_path "$SWIFT_PKG/Package.swift")"
if [[ "$SWIFT_TEST_PATH" == unknown ]]; then
    note_fail "Swift: could not read the test target's path from $SWIFT_PKG/Package.swift" \
        "SwiftPM compiles the testTarget's declared path and nothing else, so the" \
        "test root cannot be assumed — teach swift_test_target_path its shape"
else
    check_dir_discovery "Swift" swift \
        "$SWIFT_PKG/$SWIFT_TEST_PATH" "$SWIFT_PKG" \
        'XCTestCase|^[[:space:]]*@Test([[:space:](]|$)'
fi

# --- Tooth 1: the Makefile recipes ------------------------------------------
MAKE_RECIPES="$(make_recipes '^conformance-runner-tests[[:alnum:]-]*:')"
if [[ -z "$MAKE_RECIPES" ]]; then
    note_fail "Makefile: found no conformance-runner-tests* recipes to inspect" \
        "the extraction broke — this check would otherwise pass vacuously"
else
    check_no_enumeration "Makefile conformance-runner-tests* recipe" "$MAKE_RECIPES"
fi

# Tooth 1, second half: each runner-test target must still RUN its language's
# test runner.
# The invocation loop above only establishes that CI calls the target; the
# target itself is one `@true` away from running nothing, and the workflow
# would be unchanged. The TypeScript wrapper is already followed for exactly
# this reason (below), and leaving the other five trusted by name was an
# asymmetry, not a decision.
#
# One expected command per language. When a recipe legitimately changes
# tooling this table changes with it — that is the point: "what runs the
# tests" stays written down in one place instead of being inferred.
runner_target_tool() {
    case "$1" in
        go)     echo 'go test' ;;
        python) echo 'pytest' ;;
        ruby)   echo 'bundle exec ruby' ;;
        kotlin) echo ':conformance:test' ;;
        swift)  echo 'swift test' ;;
        *)      echo '' ;;
    esac
}
hollow_targets=()
for target in go python ruby kotlin swift; do
    target_recipe="$(make_recipes "^conformance-runner-tests-$target:")"
    target_tool="$(runner_target_tool "$target")"
    grep -qF -- "$target_tool" <<<"$target_recipe" \
        || hollow_targets+=("conformance-runner-tests-$target runs no '$target_tool'")
done
if [[ "${#hollow_targets[@]}" -gt 0 ]]; then
    note_fail "runner-test target(s) that no longer run their test runner" \
        "${hollow_targets[@]}" \
        "CI invoking the target is only half of it — a recipe emptied to @true" \
        "leaves the workflow unchanged and the suite unrun (#572)."
else
    pass=$((pass + 1))
    echo "  ok: all five conformance-runner-tests-* recipes run their test runner"
fi

# --- Tooth 1: the CI workflow ------------------------------------------------
# CI must reach the runner suites through the make targets, so "what runs" has
# exactly one definition. Any runner test filename in test.yml is a second
# enumeration by construction — that is how #572's two files stayed unrun even
# though both the Makefile and CI looked like they covered the directory.
WORKFLOW=.github/workflows/test.yml
if [[ ! -f "$WORKFLOW" ]]; then
    note_fail "$WORKFLOW is missing" "cannot verify CI does not re-enumerate"
else
    check_no_enumeration "$WORKFLOW" "$(cat "$WORKFLOW")"
    # And it must actually call them: a workflow that dropped the steps
    # entirely would trivially satisfy the enumeration ban.
    # Comment-stripped, like the TypeScript check below: a step commented out
    # wholesale still leaves `# - run: make conformance-runner-tests-go` in the
    # file, and a raw grep would report the target as invoked while CI no longer
    # runs it. The enumeration ban above deliberately keeps scanning the RAW
    # file — a test filename left in a comment selects nothing, but it is a
    # stale reference worth surfacing rather than hiding.
    # Comment-stripped AND disabled-block-stripped: a step commented out
    # wholesale and a step turned off by `if: ${{ false }}` are the same fact —
    # its text survives, and CI runs none of it.
    workflow_code="$(sed 's/#.*//' "$WORKFLOW" | drop_disabled_workflow_blocks)"

    # invoked_by_workflow <command-regex> — does the workflow RUN this, as
    # opposed to merely containing its text?
    #
    # `grep -q "make <target>$"` did not ask that. It accepted the name anywhere
    # in an uncommented line, so `run: echo make conformance-runner-tests-go`
    # reported the Go suite as invoked while CI ran nothing — the same
    # looks-covered-runs-nothing shape as #572, one layer out. The command has to
    # BE the command: after an optional `- ` list dash and an optional `run:`
    # key, the line must start with it (a `run: |` block body is the same shape
    # without the key), or follow a `&&`/`;`/`|` that ends the previous command
    # in a chain. `echo make …` matches neither.
    invoked_by_workflow() {
        grep -Eq "^[[:space:]]*(-[[:space:]]+)?(run:[[:space:]]*)?([^#]*(&&|;|\|)[[:space:]]*)?$1[[:space:]]*$" \
            <<<"$workflow_code"
    }

    missing_targets=()
    for target in go python ruby kotlin swift; do
        invoked_by_workflow "make[[:space:]]+conformance-runner-tests-$target" \
            || missing_targets+=("conformance-runner-tests-$target")
    done
    if [[ "${#missing_targets[@]}" -gt 0 ]]; then
        note_fail "$WORKFLOW does not invoke every per-language runner-test target" \
            "${missing_targets[@]}"
    else
        pass=$((pass + 1))
        echo "  ok: $WORKFLOW invokes all five conformance-runner-tests-* targets"
    fi


    # TypeScript is the sixth language and the only one with NO
    # conformance-runner-tests-* target: its runner tests and its conformance
    # suite are the same vitest invocation, which CI spells `npx vitest run`
    # (deliberately, not `npm test` — see the workflow's own comment about the
    # pretest rebuild). So the loop above cannot cover it, and without this the
    # TypeScript test files this check counts could disappear from CI entirely
    # while every other check still reported green. Accept either the direct
    # vitest call or the make target that wraps it.
    #
    # Both invocation checks read `workflow_code`, the comment-stripped file, and
    # both go through invoked_by_workflow. The workflow explains its own choice
    # of `npx vitest run` over `npm test` in a comment three lines above the
    # step, so a naive grep matched the PROSE and passed with the step deleted —
    # the first version of this very check did exactly that, and its red proof is
    # what caught it. Match what CI would run, not what it says about it.
    #
    # The WRAPPER form is followed rather than trusted. Accepting
    # `make conformance-typescript` while never reading that recipe meant a
    # recipe rewritten to `@true` left this printing `ok` over six suites that
    # ran nowhere — the check would have been asserting that a name appears in a
    # workflow, which is not a fact about whether tests run. So when CI takes
    # the wrapper, the recipe must reach vitest: directly, or through the `npm
    # test` script, which is followed one level into package.json rather than
    # assumed to mean vitest.
    # vitest_invocation_dirs — the effective working directory of every step
    # that runs vitest, one per line.
    #
    # `vitest run` is not self-locating: vitest's root defaults to the process
    # cwd, and the test-typescript job declares
    # `defaults: run: working-directory: typescript`. So the very same command,
    # with the step's override dropped, re-runs the SDK's own suite and touches
    # none of the runner files this check counts — while the text of the command
    # is unchanged. Matching the command without its directory asserted that a
    # string appears, not that these tests run.
    #
    # Step-level `working-directory:` wins; otherwise the job's default, taken
    # as any `working-directory:` in the job body before its `steps:` key.
    TS_RUNNER_DIR=conformance/runner/typescript
    vitest_invocation_dirs() {
        awk -v cmd='(^|[^-[:alnum:]])(npx[[:space:]]+)?vitest run([[:space:]]|$)' '
            function indent(s,   n) { n = match(s, /[^ ]/); return n ? n - 1 : -1 }
            function flush() {
                if (has_vitest) print (step_wd != "" ? step_wd : (job_wd != "" ? job_wd : "."))
                instep = 0; has_vitest = 0; step_wd = ""
            }
            /^jobs:[[:space:]]*$/ { injobs = 1; jobind = -1; next }
            {
                if (!injobs) next
                if ($0 ~ /^[[:space:]]*$/) next
                ind = indent($0)
                if (jobind < 0) jobind = ind
                if (ind <= jobind) {
                    if (instep) flush()
                    job_wd = ""; seensteps = 0
                    if (ind < jobind) injobs = 0
                    next
                }
                if ($0 ~ /^[[:space:]]*steps:[[:space:]]*$/) { seensteps = 1 }
                if (!seensteps && $0 ~ /^[[:space:]]*working-directory:/) {
                    job_wd = $0; sub(/^[^:]*:[[:space:]]*/, "", job_wd); gsub(/["'"'"']/, "", job_wd)
                }
                if ($0 ~ /^[[:space:]]*-[[:space:]]/ && (!instep || ind <= dashind)) {
                    if (instep) flush()
                    instep = 1; dashind = ind; has_vitest = 0; step_wd = ""
                }
                if (instep) {
                    if ($0 ~ /^[[:space:]]*working-directory:/) {
                        step_wd = $0; sub(/^[^:]*:[[:space:]]*/, "", step_wd); gsub(/["'"'"']/, "", step_wd)
                    }
                    if ($0 ~ cmd) has_vitest = 1
                }
            }
            END { if (instep) flush() }
        ' <<<"$workflow_code"
    }

    ts_invoked=0
    ts_detail=()
    if invoked_by_workflow '(npx[[:space:]]+)?vitest run'; then
        if grep -qxF "$TS_RUNNER_DIR" <<<"$(vitest_invocation_dirs)"; then
            ts_invoked=1
        else
            ts_detail=(
                "a 'vitest run' step exists, but none of them runs in $TS_RUNNER_DIR."
                "vitest's root is the process cwd and the TypeScript job defaults to"
                "working-directory: typescript, so that command re-runs the SDK's own"
                "suite and collects none of the runner files counted above. Effective"
                "directories found: $(vitest_invocation_dirs | tr '\n' ' ')"
            )
        fi
    elif invoked_by_workflow 'make[[:space:]]+conformance-typescript'; then
        ts_recipe="$(make_recipes '^conformance-typescript:')"
        ts_pkg=conformance/runner/typescript/package.json
        if grep -Eq 'vitest run' <<<"$ts_recipe"; then
            ts_invoked=1
        elif grep -Eq 'npm (run )?test' <<<"$ts_recipe" \
            && grep -Eq '"test"[[:space:]]*:[[:space:]]*"[^"]*vitest' "$ts_pkg" 2>/dev/null; then
            ts_invoked=1
        else
            ts_detail=(
                "the workflow takes the 'make conformance-typescript' wrapper, but that"
                "recipe reaches no vitest run — neither directly nor through an npm test"
                "script that resolves to vitest in $ts_pkg."
            )
        fi
    fi
    if [[ "$ts_invoked" -eq 1 ]]; then
        pass=$((pass + 1))
        echo "  ok: $WORKFLOW invokes the TypeScript runner suite"
    else
        note_fail "$WORKFLOW does not invoke the TypeScript runner suite" \
            "${ts_detail[@]:-no 'vitest run' command and no 'make conformance-typescript' step}" \
            "TypeScript has no conformance-runner-tests-* target, so nothing else" \
            "here would notice its suite vanishing from CI."
    fi
fi

# ---------------------------------------------------------------------------
# Self-test: prove tooth (2) fires, on BOTH halves of reachability.
#
# Each case builds a synthetic runner tree, points the whole check at it with
# REPO_ROOT, and asserts on the report. The trees are deliberately incomplete
# (no Go/Python/Kotlin/Swift dirs), so every case exits non-zero for several
# reasons at once — what is being asserted is that the probe file is named, or
# deliberately NOT named, in the output.
#
# Case 1  misnamed:  replay_runner_spec.rb, matched by no glob → reported.
# Case 2  misplaced: nested/probe_test.rb under a TOP-LEVEL Ruby recipe →
#                    reported. This is the false green that shipped: the file
#                    is correctly named, `find` reaches it, and the recipe's
#                    `for f in *_test.rb` never opens it.
# Case 3  the same nested file under a RECURSIVE Ruby recipe → NOT reported,
#                    because there it really does run. Without case 3, case 2
#                    would also pass if placement were flagged unconditionally,
#                    and the scope derivation would be decorative.
# Case 4  undetected: a Go file named examples.go holding `func Example()` →
#                    reported. This one guards the CONTENT DETECTOR rather than
#                    the globs. A marker the detector misses is worse than a
#                    misnamed file, because the arm still prints `ok` — the
#                    other Go files keep `found` nonzero, so nothing looks
#                    wrong. `[[:upper:]]` missed every unsuffixed Go test form.
# Case 5  the same hole in Python: a class-based pytest suite that imports
#                    nothing, whose `def test` is indented inside `class Test*`.
#                    `^def test_` never saw it.
# Case 6  the converse of 5, and what keeps 5 honest: the runner's own
#                    Test*-NAMED plumbing (TestResult, TestRunner, ...) must NOT
#                    be reported. Detection keys on the indented test METHOD,
#                    not on the class name, precisely so this stays quiet.
# Case 7  a Swift test in a SIBLING directory of the declared testTarget path →
#                    reported. SwiftPM compiles the target's `path` and nothing
#                    else, so "under Tests/" is not the same as "compiled".
# Case 8  a parameterized `@Test("name")` under Sources/ → reported. The marker
#                    must not demand whitespace-or-EOL after the attribute.
# Case 9  a Go _test.go under `_ignored/` → reported. `recursive` means "walks
#                    subdirectories", not "walks every subdirectory": go help
#                    packages ignores "." / "_" names and testdata dirs.
# Case 10 a Kotlin @ParameterizedTest under src/main → reported. @Test is not
#                    Jupiter's only test-declaring annotation.
# Case 11 a workflow that no longer invokes the TypeScript suite → reported.
#                    TypeScript has no conformance-runner-tests-* target, so the
#                    per-language target loop cannot speak for it.
# Case 12 a pytest suite under dist/ → reported. pytest's norecursedirs default
#                    skips it; `recursive` is the toolchain's rule, not "all".
# Case 13 a runner-test step commented out wholesale → reported missing. Its
#                    text survives in the file; only the YAML stops running.
# Case 14 a fixtures-only conftest.py → NOT reported. pytest imports it for
#                    every directory it collects, so it is reachable without
#                    matching a collection glob; `^import pytest` made the gate
#                    reject the one support module every pytest suite may have.
# Case 15 the converse, and what stops 14 from being a blanket exemption: a
#                    conftest.py that DECLARES a test → reported. pytest loads
#                    conftest.py but collects no tests from it, so that `def
#                    test_…` is run by nothing.
# Case 16 a foo.spec.ts → NOT reported. CI runs an unconfigured `vitest run`,
#                    whose default include is `**/*.{test,spec}.?(c|m)[jt]s?(x)`
#                    — `.spec.` is discovered exactly like `.test.`.
# Case 17 the converse for 16: a vitest-importing .ts matching NEITHER
#                    convention → reported. Accepting `.spec.` must not be a
#                    blanket pass for the arm.
# Case 18 a workflow step of `run: echo make conformance-runner-tests-go` →
#                    reported missing. Containing the target's NAME is not
#                    running it; the invocation check must read a command.
# Case 19 a `//go:build windows` test, and a probe_windows_test.go → reported.
#                    Name and placement are right and `go test ./...` on the CI
#                    platform compiles neither.
# Case 20 a stranded.tsx importing vitest → reported. The scan has to cover
#                    every extension the include can match; scanning `.ts` alone
#                    left this undetected, so the arm printed `ok` over it.
# Case 21 a workflow that takes `make conformance-typescript` whose recipe runs
#                    nothing → reported. Accepting the wrapper without reading
#                    its recipe asserts that a name appears in a file, not that
#                    tests run.
# Case 22 a pytest suite under build/ → reported. `build` used to sit in the
#                    global PRUNE, so find never handed the file to the arm whose
#                    norecursedirs rule exists to report it — a global prune
#                    outranking a per-arm exclusion is a blind spot, not a prune.
# Case 23 a runner-test step carrying `if: ${{ false }}` → reported missing.
#                    Actions skips it; the text stays in the file.
# Case 24 the same at JOB level → reported missing.
# Case 25 the converse of 23/24, and what bounds them: a step conditioned on
#                    `matrix.ruby == '3.3'` — which is how the real workflow
#                    runs the Ruby suite — must still count. Only a LITERALLY
#                    false condition disables; expressions are not evaluated.
# Case 26 a `vitest run` step that inherits the job's `working-directory:
#                    typescript` → reported. Same command text, different root:
#                    it re-runs the SDK suite and collects no runner file.
# Case 27 the converse: the same step with the runner-directory override → NOT
#                    reported, so 26 cannot be satisfied by the arm just failing.
# Case 28 a Minitest test_helper.rb that only requires the framework → NOT
#                    reported. It is required BY the suites, matches no glob, and
#                    declares nothing — the Ruby half of case 14.
# Case 29 the converse: a helper that DECLARES a Minitest::Test → reported.
#                    Whether it runs depends on a require edge this check cannot
#                    see, so that direction stays loud.
# Case 30 a step pinning `matrix.go == '1.25'` against a matrix that offers only
#                    1.23 and 1.24 → reported missing. Actions skips it on every
#                    leg; the step is untouched. Dropping a supported runtime is
#                    the ordinary way this happens.
# Case 31 the same pin in a job that declares no matrix at all → reported.
# Case 32 a conformance-runner-tests-go recipe emptied to `@true` → reported.
#                    CI still invokes the target, the workflow is unchanged, and
#                    the suite runs nowhere: case 21's hollow wrapper one level
#                    in.
# ---------------------------------------------------------------------------
selftest_tree() {
    # selftest_tree <dir> <ruby-recipe-body>
    local dir="$1" recipe="$2"
    mkdir -p "$dir/conformance/runner/ruby"
    printf 'require "minitest/autorun"\nclass X < Minitest::Test\n  def test_a; end\nend\n' \
        > "$dir/conformance/runner/ruby/toplevel_test.rb"
    { echo 'conformance-runner-tests-ruby:'; printf '%s\n' "$recipe"; } > "$dir/Makefile"
}

TOPLEVEL_RECIPE=$'\tcd conformance/runner/ruby && \\\n\tfor f in *_test.rb; do bundle exec ruby "$$f" || exit 1; done'
RECURSIVE_RECIPE=$'\tcd conformance/runner/ruby && \\\n\tfiles=$$(find . -type f -name \'*_test.rb\' | sort); \\\n\tfor f in $$files; do bundle exec ruby "$$f" || exit 1; done'

if [[ "$SELF_TEST" -eq 1 ]]; then
    st_fail=0
    WORK="$(mktemp -d "${TMPDIR:-/tmp}/runner-reachability-selftest.XXXXXX")" || exit 2
    trap 'rm -rf "$WORK"' EXIT

    echo ""
    echo "==> Self-test 1: a misnamed Ruby suite must be reported unreachable"
    selftest_tree "$WORK/misnamed" "$RECURSIVE_RECIPE"
    printf 'require "minitest/autorun"\nclass X < Minitest::Test\n  def test_a; end\nend\n' \
        > "$WORK/misnamed/conformance/runner/ruby/replay_runner_spec.rb"
    out="$(REPO_ROOT="$WORK/misnamed" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: self-test tree passed (exit 0) — tooth (2) is vacuous"
        st_fail=1
    elif ! grep -q 'replay_runner_spec\.rb' <<<"$out"; then
        echo "  FAIL: failed for the wrong reason — no mention of replay_runner_spec.rb"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: misnamed suite reported (exit $st)"
    fi

    echo ""
    echo "==> Self-test 2: a nested Ruby suite under a top-level recipe must be reported"
    selftest_tree "$WORK/misplaced" "$TOPLEVEL_RECIPE"
    mkdir -p "$WORK/misplaced/conformance/runner/ruby/nested"
    printf 'require "minitest/autorun"\nclass X < Minitest::Test\n  def test_a; assert false; end\nend\n' \
        > "$WORK/misplaced/conformance/runner/ruby/nested/probe_test.rb"
    out="$(REPO_ROOT="$WORK/misplaced" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: nested-probe tree passed (exit 0) — the placement tooth is vacuous"
        st_fail=1
    elif ! grep -q 'nested/probe_test\.rb' <<<"$out"; then
        echo "  FAIL: nested probe was not reported — a correctly-named, unrun file passed"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: nested suite reported unreachable under a top-level recipe (exit $st)"
    fi

    echo ""
    echo "==> Self-test 3: the same nested suite under a recursive recipe must NOT be reported"
    selftest_tree "$WORK/nested-ok" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/nested-ok/conformance/runner/ruby/nested"
    printf 'require "minitest/autorun"\nclass X < Minitest::Test\n  def test_a; end\nend\n' \
        > "$WORK/nested-ok/conformance/runner/ruby/nested/probe_test.rb"
    out="$(REPO_ROOT="$WORK/nested-ok" "$SELF" 2>&1)"
    if grep -q 'nested/probe_test\.rb' <<<"$out"; then
        echo "  FAIL: nested probe reported under a RECURSIVE recipe — placement is being"
        echo "        flagged unconditionally, so case 2 proves nothing about the scope"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: nested suite accepted where discovery actually recurses"
    fi

    echo ""
    echo "==> Self-test 4: an unsuffixed Go example outside a _test.go file must be reported"
    # Two Go files: a legitimate one so the arm's `found` count is nonzero (the
    # condition under which the old detector's miss printed `ok`), and the probe.
    selftest_tree "$WORK/go-example" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/go-example/conformance/runner/go"
    printf 'package main\n\nimport "testing"\n\nfunc TestReal(t *testing.T) {}\n' \
        > "$WORK/go-example/conformance/runner/go/real_test.go"
    printf 'package main\n\nfunc Example() {\n\t// go test runs this; it is not in a _test.go file\n}\n' \
        > "$WORK/go-example/conformance/runner/go/examples.go"
    out="$(REPO_ROOT="$WORK/go-example" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: go-example tree passed (exit 0) — the content detector is missing it"
        st_fail=1
    elif ! grep -q 'examples\.go' <<<"$out"; then
        echo "  FAIL: unsuffixed \`func Example()\` was not detected — the Go arm reports \`ok\`"
        echo "        over a file go test runs and no glob covers"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: unsuffixed Go example reported unreachable (exit $st)"
    fi

    echo ""
    echo "==> Self-test 5: a class-based pytest suite outside a collected filename must be reported"
    # Same shape as case 4, for Python: a real suite that imports nothing and
    # whose test method is indented inside a Test* class.
    selftest_tree "$WORK/py-class" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/py-class/conformance/runner/python"
    printf 'def test_real():\n    assert True\n' \
        > "$WORK/py-class/conformance/runner/python/test_real.py"
    printf 'class TestStranded:\n    def test_failure(self):\n        assert False, "pytest would run this if the file were named for collection"\n' \
        > "$WORK/py-class/conformance/runner/python/stranded.py"
    out="$(REPO_ROOT="$WORK/py-class" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: py-class tree passed (exit 0) — the content detector is missing it"
        st_fail=1
    elif ! grep -q 'stranded\.py' <<<"$out"; then
        echo "  FAIL: class-based pytest suite was not detected — the Python arm reports \`ok\`"
        echo "        over a suite no collected filename covers"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: class-based pytest suite reported unreachable (exit $st)"
    fi

    echo ""
    echo "==> Self-test 6: the runner's own Test*-named plumbing must NOT be reported"
    # The other direction, and the reason the detector keys on an indented
    # `def test` rather than on a `Test*` class name: conformance/runner/python/
    # runner.py declares TestCase, TestResult, TestRunner and TestTracker as
    # ordinary dataclasses. A name-based detector would fail the build over them.
    selftest_tree "$WORK/py-plumbing" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/py-plumbing/conformance/runner/python"
    printf 'def test_real():\n    assert True\n' \
        > "$WORK/py-plumbing/conformance/runner/python/test_real.py"
    printf 'from dataclasses import dataclass\n\n\n@dataclass\nclass TestResult:\n    passed: bool\n\n\nclass TestRunner:\n    def run(self):\n        return TestResult(True)\n' \
        > "$WORK/py-plumbing/conformance/runner/python/runner.py"
    out="$(REPO_ROOT="$WORK/py-plumbing" "$SELF" 2>&1)"
    if grep -q 'runner\.py' <<<"$out"; then
        echo "  FAIL: the runner's own Test*-named classes were reported as a stranded suite"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: Test*-named plumbing accepted (detection keys on the test method, not the class name)"
    fi

    echo ""
    echo "==> Self-test 7: a Swift test beside the declared test target must be reported"
    # SwiftPM compiles the testTarget's `path` and nothing else, so a sibling
    # directory under Tests/ is not "the test root" — it is unreachable.
    selftest_tree "$WORK/swift-sibling" "$RECURSIVE_RECIPE"
    swift_pkg="$WORK/swift-sibling/conformance/runner/swift"
    mkdir -p "$swift_pkg/Tests/ConformanceSupportTests" "$swift_pkg/Tests/ReplayTests"
    printf 'import PackageDescription\nlet package = Package(\n    name: "ConformanceRunner",\n    targets: [\n        .testTarget(\n            name: "ConformanceSupportTests",\n            path: "Tests/ConformanceSupportTests"\n        )\n    ]\n)\n' \
        > "$swift_pkg/Package.swift"
    printf 'import XCTest\nfinal class RealTests: XCTestCase {\n    func testReal() {}\n}\n' \
        > "$swift_pkg/Tests/ConformanceSupportTests/RealTests.swift"
    printf 'import XCTest\nfinal class ReplayTests: XCTestCase {\n    func testStranded() { XCTFail("compiled by nothing") }\n}\n' \
        > "$swift_pkg/Tests/ReplayTests/ReplayTests.swift"
    out="$(REPO_ROOT="$WORK/swift-sibling" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: swift-sibling tree passed (exit 0) — Tests/ is being taken as the test root"
        st_fail=1
    elif ! grep -q 'ReplayTests\.swift' <<<"$out"; then
        echo "  FAIL: a test outside the declared testTarget path was not reported"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: Swift test beside the declared target reported unreachable (exit $st)"
    fi

    echo ""
    echo "==> Self-test 8: a parameterized Swift Testing attribute must be detected"
    # `@Test("name")` and `@Test(arguments:)` are discovered by SwiftPM. A
    # marker demanding whitespace-or-EOL after @Test saw neither, so such a
    # file under Sources/ was invisible while the XCTest files kept `found`
    # nonzero and the arm printed `ok`.
    selftest_tree "$WORK/swift-attr" "$RECURSIVE_RECIPE"
    swift_pkg="$WORK/swift-attr/conformance/runner/swift"
    mkdir -p "$swift_pkg/Tests/ConformanceSupportTests" "$swift_pkg/Sources/ConformanceSupport"
    printf 'import PackageDescription\nlet package = Package(\n    name: "ConformanceRunner",\n    targets: [\n        .testTarget(\n            name: "ConformanceSupportTests",\n            path: "Tests/ConformanceSupportTests"\n        )\n    ]\n)\n' \
        > "$swift_pkg/Package.swift"
    printf 'import XCTest\nfinal class RealTests: XCTestCase {\n    func testReal() {}\n}\n' \
        > "$swift_pkg/Tests/ConformanceSupportTests/RealTests.swift"
    printf 'import Testing\n\n@Test("a display name")\nfunc stranded() {\n    #expect(Bool(false))\n}\n' \
        > "$swift_pkg/Sources/ConformanceSupport/Stranded.swift"
    out="$(REPO_ROOT="$WORK/swift-attr" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: swift-attr tree passed (exit 0) — the parameterized @Test is invisible"
        st_fail=1
    elif ! grep -q 'Stranded\.swift' <<<"$out"; then
        echo "  FAIL: \`@Test(\"…\")\` was not detected — the Swift arm reports \`ok\`"
        echo "        over a test SwiftPM discovers and the test target does not compile"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: parameterized Swift Testing attribute reported unreachable (exit $st)"
    fi

    echo ""
    echo "==> Self-test 9: a Go test under an underscore directory must be reported"
    # `recursive` means "walks subdirectories", not "walks every subdirectory".
    # go help packages: names beginning with "." or "_", and directories named
    # testdata, are ignored by the go tool — so `go test ./...` never compiles
    # this file, while the glob matches and `find` reaches it.
    selftest_tree "$WORK/go-ignored" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/go-ignored/conformance/runner/go/_ignored"
    printf 'package main\n\nimport "testing"\n\nfunc TestReal(t *testing.T) {}\n' \
        > "$WORK/go-ignored/conformance/runner/go/real_test.go"
    printf 'package ignored\n\nimport "testing"\n\nfunc TestProbe(t *testing.T) { t.Fatal("executed by nothing") }\n' \
        > "$WORK/go-ignored/conformance/runner/go/_ignored/probe_test.go"
    out="$(REPO_ROOT="$WORK/go-ignored" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: go-ignored tree passed (exit 0) — _ dirs are being treated as discoverable"
        st_fail=1
    elif ! grep -q '_ignored/probe_test\.go' <<<"$out"; then
        echo "  FAIL: a _test.go under _ignored/ was not reported — the glob matched and"
        echo "        \`go test ./...\` skipped it"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: Go test in a toolchain-ignored directory reported unreachable (exit $st)"
    fi

    echo ""
    echo "==> Self-test 10: a JUnit Jupiter @ParameterizedTest under src/main must be reported"
    # @Test is not Jupiter's only test-declaring annotation. A @ParameterizedTest
    # (or @RepeatedTest/@TestFactory/@TestTemplate) stranded in the main source
    # set is compiled into the product and run by nothing, while DelayGapsTest
    # and friends keep `found` nonzero so the arm prints `ok`.
    selftest_tree "$WORK/kt-jupiter" "$RECURSIVE_RECIPE"
    kt_test="$WORK/kt-jupiter/kotlin/conformance/src/test/kotlin"
    kt_main="$WORK/kt-jupiter/kotlin/conformance/src/main/kotlin"
    mkdir -p "$kt_test" "$kt_main"
    printf 'import org.junit.jupiter.api.Test\n\nclass RealTest {\n    @Test\n    fun real() {}\n}\n' \
        > "$kt_test/RealTest.kt"
    printf 'import org.junit.jupiter.params.ParameterizedTest\nimport org.junit.jupiter.params.provider.ValueSource\n\nclass StrandedTest {\n    @ParameterizedTest\n    @ValueSource(ints = [1, 2])\n    fun stranded(n: Int) {\n        throw AssertionError("compiled into the product, run by nothing")\n    }\n}\n' \
        > "$kt_main/StrandedTest.kt"
    out="$(REPO_ROOT="$WORK/kt-jupiter" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: kt-jupiter tree passed (exit 0) — @ParameterizedTest is invisible"
        st_fail=1
    elif ! grep -q 'StrandedTest\.kt' <<<"$out"; then
        echo "  FAIL: @ParameterizedTest was not detected — the Kotlin arm reports \`ok\`"
        echo "        over a test Gradle runs and the main source set does not host"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: Jupiter @ParameterizedTest reported unreachable (exit $st)"
    fi

    echo ""
    echo "==> Self-test 11: a workflow that stops invoking the TypeScript suite must be reported"
    # TypeScript has no conformance-runner-tests-* target, so the per-language
    # target loop cannot cover it. Drop the vitest step and nothing else here
    # notices the whole suite leaving CI.
    selftest_tree "$WORK/ts-uninvoked" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/ts-uninvoked/.github/workflows"
    {
        echo 'jobs:'
        echo '  test:'
        echo '    steps:'
        for t in go python ruby kotlin swift; do
            echo "      - run: make conformance-runner-tests-$t"
        done
    } > "$WORK/ts-uninvoked/.github/workflows/test.yml"
    out="$(REPO_ROOT="$WORK/ts-uninvoked" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: ts-uninvoked tree passed (exit 0) — the TS suite can leave CI unnoticed"
        st_fail=1
    elif ! grep -q 'does not invoke the TypeScript runner suite' <<<"$out"; then
        echo "  FAIL: a workflow with no vitest step was not reported"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: missing TypeScript invocation reported (exit $st)"
    fi

    echo ""
    echo "==> Self-test 12: a pytest suite under dist/ must be reported"
    # pytest's norecursedirs default skips dist/, venv/, build/, dot-dirs and
    # friends. A correctly-named test there is matched by the glob and collected
    # by nothing.
    selftest_tree "$WORK/py-norecurse" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/py-norecurse/conformance/runner/python/dist"
    printf 'def test_real():\n    assert True\n' \
        > "$WORK/py-norecurse/conformance/runner/python/test_real.py"
    printf 'def test_stranded():\n    assert False, "collected by nothing"\n' \
        > "$WORK/py-norecurse/conformance/runner/python/dist/test_stranded.py"
    out="$(REPO_ROOT="$WORK/py-norecurse" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: py-norecurse tree passed (exit 0) — dist/ is being treated as collected"
        st_fail=1
    elif ! grep -q 'dist/test_stranded\.py' <<<"$out"; then
        echo "  FAIL: a test under dist/ was not reported — the glob matched and pytest"
        echo "        never collected it"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: pytest suite in a norecursedirs location reported unreachable (exit $st)"
    fi

    echo ""
    echo "==> Self-test 13: a commented-out runner-test step must not count as invoked"
    # A step commented out wholesale leaves its text in the file. A raw grep
    # would report the target as invoked while CI no longer runs it.
    selftest_tree "$WORK/wf-commented" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/wf-commented/.github/workflows"
    {
        echo 'jobs:'
        echo '  test:'
        echo '    steps:'
        echo '      # - run: make conformance-runner-tests-go'
        for t in python ruby kotlin swift; do
            echo "      - run: make conformance-runner-tests-$t"
        done
        echo '      - run: npx vitest run'
    } > "$WORK/wf-commented/.github/workflows/test.yml"
    out="$(REPO_ROOT="$WORK/wf-commented" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: wf-commented tree passed (exit 0) — a commented step counts as invoked"
        st_fail=1
    elif ! grep -q 'conformance-runner-tests-go' <<<"$out"; then
        echo "  FAIL: the commented-out Go step was still counted as an invocation"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: commented-out runner-test step reported missing (exit $st)"
    fi

    echo ""
    echo "==> Self-test 14: a fixtures-only conftest.py must NOT be reported"
    # pytest imports conftest.py automatically for every directory it collects,
    # and its name matches neither collection glob — so counting `import pytest`
    # as a test declaration failed the build over the one support module every
    # pytest suite is entitled to have. Verified against pytest 9.1.1: with this
    # exact pair, `pytest -q` collects 1 test and passes.
    selftest_tree "$WORK/py-conftest" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/py-conftest/conformance/runner/python"
    printf 'def test_uses_the_fixture(wire):\n    assert wire["status"] == 204\n' \
        > "$WORK/py-conftest/conformance/runner/python/test_real.py"
    printf 'import pytest\n\n\n@pytest.fixture\ndef wire():\n    return {"status": 204}\n' \
        > "$WORK/py-conftest/conformance/runner/python/conftest.py"
    out="$(REPO_ROOT="$WORK/py-conftest" "$SELF" 2>&1)"
    if grep -q 'conformance/runner/python/conftest\.py' <<<"$out"; then
        echo "  FAIL: a fixtures-only conftest.py was reported unreachable, but pytest"
        echo "        loads it for every directory it collects"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    elif ! grep -q 'ok: Python' <<<"$out"; then
        echo "  FAIL: the Python arm did not report ok, so its silence about conftest.py"
        echo "        proves nothing — it bailed out before judging any file"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: fixtures-only conftest.py accepted (pytest imports it automatically)"
    fi

    echo ""
    echo "==> Self-test 15: a conftest.py that DECLARES a test must still be reported"
    # The other half of case 14, and what keeps it from being a blanket
    # exemption. pytest LOADS conftest.py but does not COLLECT from it: the name
    # matches no `python_files` pattern, so a `def test_…` written there is
    # executed by nothing. Verified against pytest 9.1.1 — a deliberately
    # failing test_declared_in_conftest() in conftest.py, and `pytest -q` still
    # collects 1 test (the one in test_real.py) and passes.
    selftest_tree "$WORK/py-conftest-test" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/py-conftest-test/conformance/runner/python"
    printf 'def test_real():\n    assert True\n' \
        > "$WORK/py-conftest-test/conformance/runner/python/test_real.py"
    printf 'import pytest\n\n\n@pytest.fixture\ndef wire():\n    return {}\n\n\ndef test_declared_in_conftest():\n    assert False, "pytest never collects this"\n' \
        > "$WORK/py-conftest-test/conformance/runner/python/conftest.py"
    out="$(REPO_ROOT="$WORK/py-conftest-test" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: py-conftest-test tree passed (exit 0) — conftest.py is being exempted"
        echo "        wholesale, so a test written there is run by nothing and reported by"
        echo "        nothing"
        st_fail=1
    elif ! grep -q 'conformance/runner/python/conftest\.py' <<<"$out"; then
        echo "  FAIL: a \`def test_…\` in conftest.py was not reported — pytest collects no"
        echo "        tests from conftest.py, so that assertion never runs"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: test declared in conftest.py reported unreachable (exit $st)"
    fi

    echo ""
    echo "==> Self-test 16: a .spec.ts suite must NOT be reported"
    # CI runs an unconfigured `vitest run`, whose default include is
    # `**/*.{test,spec}.?(c|m)[jt]s?(x)`. A gate that accepts only `*.test.ts`
    # fails a file vitest really does collect — the false-positive direction,
    # and the one that gets a gate switched off rather than fixed.
    selftest_tree "$WORK/ts-spec" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/ts-spec/conformance/runner/typescript"
    printf "import { describe, it, expect } from 'vitest';\n\ndescribe('runner', () => {\n  it('runs', () => { expect(1).toBe(1); });\n});\n" \
        > "$WORK/ts-spec/conformance/runner/typescript/runner.test.ts"
    printf "import { describe, it, expect } from 'vitest';\n\ndescribe('probe', () => {\n  it('is collected by the default include', () => { expect(1).toBe(1); });\n});\n" \
        > "$WORK/ts-spec/conformance/runner/typescript/probe.spec.ts"
    out="$(REPO_ROOT="$WORK/ts-spec" "$SELF" 2>&1)"
    if grep -q 'conformance/runner/typescript/probe\.spec\.ts' <<<"$out"; then
        echo "  FAIL: probe.spec.ts was reported unreachable, but vitest's default include"
        echo "        collects .spec. exactly like .test."
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    elif ! grep -q 'ok: TypeScript' <<<"$out"; then
        echo "  FAIL: the TypeScript arm did not report ok, so its silence about"
        echo "        probe.spec.ts proves nothing — it bailed out before judging any file"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: .spec.ts suite accepted (vitest's other default convention)"
    fi

    echo ""
    echo "==> Self-test 17: a vitest suite matching NEITHER convention must be reported"
    # The converse of 16: accepting `.spec.` must widen the arm by exactly one
    # convention, not disarm it. `stranded.ts` registers tests and is collected
    # by nothing — the #572 shape.
    selftest_tree "$WORK/ts-misnamed" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/ts-misnamed/conformance/runner/typescript"
    printf "import { describe, it, expect } from 'vitest';\n\ndescribe('runner', () => {\n  it('runs', () => { expect(1).toBe(1); });\n});\n" \
        > "$WORK/ts-misnamed/conformance/runner/typescript/runner.test.ts"
    printf "import { describe, it, expect } from 'vitest';\n\ndescribe('stranded', () => {\n  it('is collected by nothing', () => { expect(1).toBe(2); });\n});\n" \
        > "$WORK/ts-misnamed/conformance/runner/typescript/stranded.ts"
    out="$(REPO_ROOT="$WORK/ts-misnamed" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: ts-misnamed tree passed (exit 0) — the TypeScript arm is vacuous"
        st_fail=1
    elif ! grep -q 'conformance/runner/typescript/stranded\.ts' <<<"$out"; then
        echo "  FAIL: a vitest suite named for neither convention was not reported"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: vitest suite matching neither convention reported unreachable (exit $st)"
    fi

    echo ""
    echo "==> Self-test 18: a runner-test target that is only ECHOED is not invoked"
    # `run: echo make conformance-runner-tests-go` leaves the workflow valid and
    # the target's name in an uncommented line, while CI runs no Go runner test.
    # Containing the name is not running the command.
    selftest_tree "$WORK/wf-echoed" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/wf-echoed/.github/workflows"
    {
        echo 'jobs:'
        echo '  test:'
        echo '    steps:'
        echo '      - run: echo make conformance-runner-tests-go'
        for t in python ruby kotlin swift; do
            echo "      - run: make conformance-runner-tests-$t"
        done
        echo '      - run: npx vitest run'
    } > "$WORK/wf-echoed/.github/workflows/test.yml"
    out="$(REPO_ROOT="$WORK/wf-echoed" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: wf-echoed tree passed (exit 0) — an echoed target counts as invoked"
        st_fail=1
    elif ! grep -q 'does not invoke every per-language runner-test target' <<<"$out"; then
        echo "  FAIL: \`echo make conformance-runner-tests-go\` was counted as an invocation"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: echoed-only runner-test target reported missing (exit $st)"
    fi

    echo ""
    echo "==> Self-test 19: a build-constrained Go test must be reported"
    # Both mechanisms `go help build` gives: an explicit //go:build line, and the
    # implicit constraint a _GOOS filename carries. Either one means
    # `go test ./...` on the CI platform compiles nothing in the file, while the
    # glob matches, find reaches it, and the discovery arm counts it reachable.
    selftest_tree "$WORK/go-constrained" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/go-constrained/conformance/runner/go"
    printf 'package main\n\nimport "testing"\n\nfunc TestReal(t *testing.T) {}\n' \
        > "$WORK/go-constrained/conformance/runner/go/real_test.go"
    printf '//go:build windows\n\npackage main\n\nimport "testing"\n\nfunc TestTagged(t *testing.T) { t.Fatal("never built on the CI runner") }\n' \
        > "$WORK/go-constrained/conformance/runner/go/tagged_test.go"
    printf 'package main\n\nimport "testing"\n\nfunc TestSuffixed(t *testing.T) { t.Fatal("never built on the CI runner") }\n' \
        > "$WORK/go-constrained/conformance/runner/go/probe_windows_test.go"
    out="$(REPO_ROOT="$WORK/go-constrained" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: go-constrained tree passed (exit 0) — constraints are being ignored"
        st_fail=1
    elif ! grep -q 'tagged_test\.go' <<<"$out" || ! grep -q 'probe_windows_test\.go' <<<"$out"; then
        echo "  FAIL: a build-constrained Go test was not reported — \`go test ./...\` on"
        echo "        the CI platform compiles it into nothing"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: both build-constraint forms reported unreachable (exit $st)"
    fi

    echo ""
    echo "==> Self-test 20: a vitest suite in another supported extension must be reported"
    # The scan has to cover every extension vitest's include can match. Scanning
    # `.ts` alone made this file invisible — and invisible is the silent
    # direction: the .ts suites keep `found` nonzero, so the arm prints `ok`.
    selftest_tree "$WORK/ts-tsx" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/ts-tsx/conformance/runner/typescript"
    printf "import { describe, it, expect } from 'vitest';\n\ndescribe('runner', () => {\n  it('runs', () => { expect(1).toBe(1); });\n});\n" \
        > "$WORK/ts-tsx/conformance/runner/typescript/runner.test.ts"
    printf "import { describe, it, expect } from 'vitest';\n\ndescribe('stranded', () => {\n  it('is collected by nothing', () => { expect(1).toBe(2); });\n});\n" \
        > "$WORK/ts-tsx/conformance/runner/typescript/stranded.tsx"
    out="$(REPO_ROOT="$WORK/ts-tsx" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: ts-tsx tree passed (exit 0) — .tsx is outside the scanned set"
        st_fail=1
    elif ! grep -q 'conformance/runner/typescript/stranded\.tsx' <<<"$out"; then
        echo "  FAIL: a vitest suite in a .tsx file was not reported — unscanned means"
        echo "        undetected, and the arm reports \`ok\` over it"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: vitest suite in another supported extension reported unreachable (exit $st)"
    fi

    echo ""
    echo "==> Self-test 21: the accepted TypeScript wrapper must actually run the suite"
    # CI may reach vitest through `make conformance-typescript`. Accepting that
    # step without reading the recipe asserts only that a name appears in a
    # workflow — a recipe rewritten to `@true` ran nothing while this printed ok.
    selftest_tree "$WORK/ts-hollow-wrapper" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/ts-hollow-wrapper/.github/workflows"
    {
        echo 'conformance-typescript:'
        printf '\t@true\n'
        echo ''
        echo 'conformance-runner-tests-ruby:'
        printf '%s\n' "$RECURSIVE_RECIPE"
    } > "$WORK/ts-hollow-wrapper/Makefile"
    {
        echo 'jobs:'
        echo '  test:'
        echo '    steps:'
        for t in go python ruby kotlin swift; do
            echo "      - run: make conformance-runner-tests-$t"
        done
        echo '      - run: make conformance-typescript'
    } > "$WORK/ts-hollow-wrapper/.github/workflows/test.yml"
    out="$(REPO_ROOT="$WORK/ts-hollow-wrapper" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: ts-hollow-wrapper tree passed (exit 0) — the wrapper is trusted unread"
        st_fail=1
    elif ! grep -q 'does not invoke the TypeScript runner suite' <<<"$out"; then
        echo "  FAIL: a 'make conformance-typescript' step whose recipe runs nothing was"
        echo "        counted as invoking the suite"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: hollow TypeScript wrapper reported (exit $st)"
    fi

    echo ""
    echo "==> Self-test 22: a pytest suite under build/ must be reported"
    # Same fact as case 12 (dist/), against the directory the global PRUNE used
    # to hide. `build` is in pytest's norecursedirs default AND was in PRUNE, so
    # find never handed the file over and the arm reported nothing — a check
    # exiting 0 over a guaranteed-failing, collected-by-nothing test.
    selftest_tree "$WORK/py-build" "$RECURSIVE_RECIPE"
    mkdir -p "$WORK/py-build/conformance/runner/python/build"
    printf 'def test_real():\n    assert True\n' \
        > "$WORK/py-build/conformance/runner/python/test_real.py"
    printf 'def test_stranded():\n    assert False, "collected by nothing"\n' \
        > "$WORK/py-build/conformance/runner/python/build/test_stranded.py"
    out="$(REPO_ROOT="$WORK/py-build" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: py-build tree passed (exit 0) — build/ is pruned before the Python"
        echo "        arm can classify it as a location pytest skips"
        st_fail=1
    elif ! grep -q 'build/test_stranded\.py' <<<"$out"; then
        echo "  FAIL: a test under build/ was not reported — pytest's norecursedirs skips"
        echo "        it and this check never saw it"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: pytest suite under build/ reported unreachable (exit $st)"
    fi

    # Cases 23-25 share a workflow shape; only the Go step's condition varies.
    # <cond-line> is inserted into the Go step, <job-cond> into the job.
    selftest_workflow() {
        local dir="$1" step_cond="$2" job_cond="$3" matrix="${4:-}"
        mkdir -p "$dir/.github/workflows"
        {
            echo 'jobs:'
            echo '  test:'
            [[ -n "$job_cond" ]] && echo "    $job_cond"
            if [[ -n "$matrix" ]]; then
                echo '    strategy:'
                echo '      matrix:'
                echo "        go: [$matrix]"
            fi
            echo '    steps:'
            echo '      - name: Go runner tests'
            [[ -n "$step_cond" ]] && echo "        $step_cond"
            echo '        run: make conformance-runner-tests-go'
            local t
            for t in python ruby kotlin swift; do
                echo "      - run: make conformance-runner-tests-$t"
            done
            echo '      - run: npx vitest run'
        } > "$dir/.github/workflows/test.yml"
    }

    echo ""
    echo "==> Self-test 23: a runner-test step disabled by if: false is not invoked"
    selftest_tree "$WORK/wf-step-off" "$RECURSIVE_RECIPE"
    # shellcheck disable=SC2016  # ${{ }} is GitHub Actions syntax, not shell
    selftest_workflow "$WORK/wf-step-off" 'if: ${{ false }}' ''
    out="$(REPO_ROOT="$WORK/wf-step-off" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: wf-step-off tree passed (exit 0) — a disabled step counts as invoked"
        st_fail=1
    elif ! grep -q 'conformance-runner-tests-go' <<<"$out"; then
        echo "  FAIL: a step carrying \`if: \${{ false }}\` was counted as an invocation"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: step disabled by if: false reported missing (exit $st)"
    fi

    echo ""
    echo "==> Self-test 24: a runner-test JOB disabled by if: false is not invoked"
    selftest_tree "$WORK/wf-job-off" "$RECURSIVE_RECIPE"
    selftest_workflow "$WORK/wf-job-off" '' 'if: false'
    out="$(REPO_ROOT="$WORK/wf-job-off" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: wf-job-off tree passed (exit 0) — a disabled job counts as invoked"
        st_fail=1
    elif ! grep -q 'conformance-runner-tests-go' <<<"$out"; then
        echo "  FAIL: a job carrying \`if: false\` was counted as invoking its steps"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: job disabled by if: false reported missing (exit $st)"
    fi

    echo ""
    echo "==> Self-test 25: a matrix-conditioned step must STILL count as invoked"
    # The bound on 23/24, and not hypothetical: the real workflow runs the Ruby
    # runner tests under `if: matrix.ruby == '3.3'`. Treating any `if:` as
    # disqualifying would fail the workflow this check is meant to protect —
    # broadening the step predicate to a bare `if:` drops that step and reports
    # conformance-runner-tests-ruby missing against the real file.
    #
    # BOTH predicates are planted, step and job. An earlier version of this case
    # carried only the step condition, and a mutant that broadened the JOB
    # predicate to a bare `if:` passed the whole self-test — a quiet case that
    # covers one of two paths is a quiet case that proves one of two things.
    selftest_tree "$WORK/wf-matrix" "$RECURSIVE_RECIPE"
    selftest_workflow "$WORK/wf-matrix" "if: matrix.go == '1.25'" \
        "if: github.event_name == 'push'" "'1.24', '1.25'"
    out="$(REPO_ROOT="$WORK/wf-matrix" "$SELF" 2>&1)"
    if grep -q 'does not invoke every per-language runner-test target' <<<"$out"; then
        echo "  FAIL: a matrix-conditioned step was treated as disabled — expressions are"
        echo "        not evaluated here, and only a literally false condition disables"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    elif ! grep -q 'invokes all five conformance-runner-tests-\* targets' <<<"$out"; then
        echo "  FAIL: the invocation check did not report ok, so its silence proves"
        echo "        nothing about the matrix-conditioned step"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: matrix-conditioned runner-test step still counts as invoked"
    fi

    # Cases 26-27: the vitest step, with and without the directory override.
    # The job default mirrors the real workflow's `working-directory: typescript`.
    selftest_vitest_workflow() {
        local dir="$1" step_wd="$2"
        mkdir -p "$dir/.github/workflows"
        {
            echo 'jobs:'
            echo '  test-typescript:'
            echo '    defaults:'
            echo '      run:'
            echo '        working-directory: typescript'
            echo '    steps:'
            local t
            for t in go python ruby kotlin swift; do
                echo "      - run: make conformance-runner-tests-$t"
            done
            echo '      - name: Run TypeScript conformance tests'
            [[ -n "$step_wd" ]] && echo "        working-directory: $step_wd"
            echo '        run: |'
            echo '          npm ci'
            echo '          npx vitest run'
        } > "$dir/.github/workflows/test.yml"
    }

    echo ""
    echo "==> Self-test 26: a vitest step in the wrong working directory is not an invocation"
    # vitest's root is the process cwd, so the same command under the job's
    # `working-directory: typescript` re-runs the SDK's suite and collects none
    # of the runner files this check counts.
    selftest_tree "$WORK/ts-wrong-dir" "$RECURSIVE_RECIPE"
    selftest_vitest_workflow "$WORK/ts-wrong-dir" ''
    out="$(REPO_ROOT="$WORK/ts-wrong-dir" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: ts-wrong-dir tree passed (exit 0) — the command's root is not checked"
        st_fail=1
    elif ! grep -q 'does not invoke the TypeScript runner suite' <<<"$out"; then
        echo "  FAIL: a 'vitest run' inheriting working-directory: typescript was counted"
        echo "        as invoking the runner suite"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: vitest step in the wrong working directory reported (exit $st)"
    fi

    echo ""
    echo "==> Self-test 27: the same step WITH the runner-directory override counts"
    selftest_tree "$WORK/ts-right-dir" "$RECURSIVE_RECIPE"
    selftest_vitest_workflow "$WORK/ts-right-dir" conformance/runner/typescript
    out="$(REPO_ROOT="$WORK/ts-right-dir" "$SELF" 2>&1)"
    if ! grep -q 'ok: .*invokes the TypeScript runner suite' <<<"$out"; then
        echo "  FAIL: a correctly-overridden vitest step was reported as not invoking the"
        echo "        suite — case 26 would then pass for the wrong reason"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: overridden vitest step accepted as the runner-suite invocation"
    fi

    echo ""
    echo "==> Self-test 28: a require-only Minitest helper must NOT be reported"
    # The Ruby half of case 14. A conventional test_helper.rb requires
    # minitest/autorun to configure shared helpers, is required BY the suites
    # rather than discovered, and matches no *_test.rb glob.
    selftest_tree "$WORK/rb-helper" "$RECURSIVE_RECIPE"
    printf 'require "minitest/autorun"\nrequire "json"\n\nFIXTURE_ROOT = File.expand_path("../fixtures", __dir__)\n' \
        > "$WORK/rb-helper/conformance/runner/ruby/test_helper.rb"
    out="$(REPO_ROOT="$WORK/rb-helper" "$SELF" 2>&1)"
    if grep -q 'conformance/runner/ruby/test_helper\.rb' <<<"$out"; then
        echo "  FAIL: a require-only test_helper.rb was reported unreachable — it declares"
        echo "        no test and is loaded by the suites that require it"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    elif ! grep -q 'ok: Ruby' <<<"$out"; then
        echo "  FAIL: the Ruby arm did not report ok, so its silence about test_helper.rb"
        echo "        proves nothing — it bailed out before judging any file"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: require-only Minitest helper accepted (loaded by the suites, not discovered)"
    fi

    echo ""
    echo "==> Self-test 29: a helper that DECLARES a Minitest test must still be reported"
    # The bound on 28. minitest/autorun runs every test class loaded into the
    # process, so whether this one executes depends on some *_test.rb requiring
    # the file — an edge this check cannot see and will not assume.
    selftest_tree "$WORK/rb-helper-test" "$RECURSIVE_RECIPE"
    printf 'require "minitest/autorun"\n\nclass StrandedTest < Minitest::Test\n  def test_stranded\n    flunk "reached only if some *_test.rb requires this file"\n  end\nend\n' \
        > "$WORK/rb-helper-test/conformance/runner/ruby/test_helper.rb"
    out="$(REPO_ROOT="$WORK/rb-helper-test" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: rb-helper-test tree passed (exit 0) — helpers are exempted wholesale"
        st_fail=1
    elif ! grep -q 'conformance/runner/ruby/test_helper\.rb' <<<"$out"; then
        echo "  FAIL: a Minitest::Test declared in a helper was not reported"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: test declared in a Minitest helper reported unreachable (exit $st)"
    fi

    echo ""
    echo "==> Self-test 30: a step pinning a matrix value the matrix dropped is not invoked"
    # The natural recurrence: supported runtimes move on, `'3.3'` leaves
    # matrix.ruby, and the step conditioned on it is skipped on every leg with
    # the step itself untouched. Nothing in the diff says the suite stopped
    # running.
    selftest_tree "$WORK/wf-matrix-gone" "$RECURSIVE_RECIPE"
    selftest_workflow "$WORK/wf-matrix-gone" "if: matrix.go == '1.25'" '' "'1.23', '1.24'"
    out="$(REPO_ROOT="$WORK/wf-matrix-gone" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: wf-matrix-gone tree passed (exit 0) — an unsatisfiable matrix pin"
        echo "        counts as invoked"
        st_fail=1
    elif ! grep -q 'conformance-runner-tests-go' <<<"$out"; then
        echo "  FAIL: a step pinning matrix.go == '1.25' was counted while the matrix"
        echo "        offers only 1.23 and 1.24"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: unsatisfiable matrix pin reported missing (exit $st)"
    fi

    echo ""
    echo "==> Self-test 31: a matrix pin in a job with NO matrix is not invoked either"
    selftest_tree "$WORK/wf-matrix-none" "$RECURSIVE_RECIPE"
    selftest_workflow "$WORK/wf-matrix-none" "if: matrix.go == '1.25'" '' ''
    out="$(REPO_ROOT="$WORK/wf-matrix-none" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: wf-matrix-none tree passed (exit 0) — a matrix pin with no matrix"
        echo "        counts as invoked"
        st_fail=1
    elif ! grep -q 'conformance-runner-tests-go' <<<"$out"; then
        echo "  FAIL: a matrix pin in a job that declares no matrix was counted"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: matrix pin with no matrix reported missing (exit $st)"
    fi

    echo ""
    echo "==> Self-test 32: a runner-test recipe emptied to @true must be reported"
    # CI invoking the target is only half of it. Rewriting the Go recipe to
    # @true leaves the workflow byte-identical and the suite unrun — the same
    # hollow-wrapper shape as case 21, one level in.
    selftest_tree "$WORK/mk-hollow" "$RECURSIVE_RECIPE"
    {
        echo 'conformance-runner-tests-go:'
        printf '\t@true\n'
        echo ''
        echo 'conformance-runner-tests-ruby:'
        printf '%s\n' "$RECURSIVE_RECIPE"
    } > "$WORK/mk-hollow/Makefile"
    out="$(REPO_ROOT="$WORK/mk-hollow" "$SELF" 2>&1)"
    st=$?
    if [[ "$st" -eq 0 ]]; then
        echo "  FAIL: mk-hollow tree passed (exit 0) — recipes are trusted by name"
        st_fail=1
    elif ! grep -q "conformance-runner-tests-go runs no 'go test'" <<<"$out"; then
        echo "  FAIL: a Go recipe emptied to @true was not reported — CI still calls the"
        echo "        target, and the target runs nothing"
        # shellcheck disable=SC2001  # indenting every line, not a substring swap
        sed 's/^/        /' <<<"$out"
        st_fail=1
    else
        echo "  ok: hollow runner-test recipe reported (exit $st)"
    fi

    echo ""
    if [[ "$st_fail" -eq 0 ]]; then
        echo "==> Self-test passed"
        exit 0
    fi
    echo "==> Self-test FAILED"
    exit 1
fi

echo ""
if [[ "$fail" -eq 0 ]]; then
    echo "==> Runner-test reachability clean ($pass checks passed)"
    exit 0
else
    echo "==> Runner-test reachability FAILED ($fail failure(s), $pass passed)"
    exit 1
fi
