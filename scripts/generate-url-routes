#!/usr/bin/env bash
#
# Generate url-routes.json from OpenAPI spec.
#
# Extracts URL route patterns grouped by path, with resource tags,
# operations (method → operationId), and typed parameter metadata.
# This is the SDK's equivalent of Rails route recognition data.
#
# Prerequisites: openapi.json must exist (produced by `make smithy-build`).
#
# Usage: ./generate-url-routes [openapi.json] [output.json]
#        ./generate-url-routes  # uses defaults

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

OPENAPI_FILE="${1:-$PROJECT_ROOT/openapi.json}"
OUTPUT_FILE="${2:-$PROJECT_ROOT/go/pkg/basecamp/url-routes.json}"

if [[ ! -f "$OPENAPI_FILE" ]]; then
    echo "Error: OpenAPI file not found: $OPENAPI_FILE" >&2
    echo "Run 'make smithy-build' first to generate the OpenAPI spec." >&2
    exit 1
fi

# Generate url-routes using jq.
#
# Into a TEMPORARY file, then moved into place: the shell truncates a redirect
# target before the command runs, so writing straight at url-routes.json would
# empty it and only then let the filter refuse, turning a fail-closed refusal
# into data loss. The trap removes the temporary file on a refusal, so a failed
# run leaves neither a truncated artifact nor a stale fragment beside it.
trap 'rm -f "${OUTPUT_FILE}.tmp"' EXIT
jq '
# A $ref path item points at operations this filter cannot see without
# resolving the reference. Skipping it would hand back exactly the silent
# under-count the exclusion walk below exists to prevent, so refuse instead.
def refuse_path_item_refs:
  [.paths | to_entries[] | select(.value | has("$ref")) | .key] as $refs |
  if ($refs | length) > 0 then
    error("openapi.json path items are behind a $ref this generator cannot resolve: \($refs | join(", ")). Inline them, or teach this filter to resolve local references -- skipping them would hide every operation behind them from the route table.")
  else . end;

# OpenAPI 3.2 additionalOperations is a MAP of method to Operation, not an
# operation. The exclusion walk below would read it as one field with no
# operationId and emit a route entry naming nothing, so refuse by name until this
# filter learns the map shape.
def refuse_additional_operations:
  [.paths | to_entries[] | select(.value | has("additionalOperations")) | .key] as $maps |
  if ($maps | length) > 0 then
    error("openapi.json path items declare additionalOperations, which OpenAPI 3.2 defines as a map of method to Operation: \($maps | join(", ")). This filter reads a path-item field as a single operation, so it would drop every operation inside it.")
  else . end;

# Every field the exclusion walk takes for an operation has to BE one. A scalar
# reaches .value.operationId and errors obliquely; an object with no operationId
# would reach the route table as a method naming null. Both are the silent
# under-report the walk exists to prevent, so both are named here instead.
def refuse_unreadable_operations:
  [ .paths | to_entries[] | .key as $p | .value | to_entries[]
    | select((.key | IN("summary","description","servers","parameters") | not)
             and (.key | startswith("x-") | not))
    | select((.value | type) != "object" or (.value.operationId | type) != "string" or (.value.operationId == ""))
    | "\($p) -> \(.key)" ] as $bad |
  if ($bad | length) > 0 then
    error("openapi.json path-item fields are neither a known non-operation field nor an operation with an operationId: \($bad | join(", ")). A later OpenAPI version may have added a non-operation field -- add it to the exclusion list with a reason rather than letting it reach the route table unnamed.")
  else . end;

# Infer parameter role from its name.
# - accountId → "account"
# - projectId → "bucket"
# - Terminal resource IDs (todoId, messageId, cardId) → "recording"
# - Mid-path parent IDs (todolistId, boardId, columnId) → "parent"
# The role is refined per-route below based on position in the pattern.
def param_role($name; $pattern):
  if $name == "accountId" then "account"
  elif $name == "projectId" then "bucket"
  else
    # Check if this param is the last path segment in the pattern
    ($pattern | split("/") | last) as $last_seg |
    if $last_seg == ("{\($name)}") then "recording"
    else "parent"
    end
  end;

# Extract parameter type from OpenAPI schema
def param_type:
  if .schema.type == "integer" then
    if .schema.format == "int64" then "int64" else "int" end
  else "string"
  end;

refuse_path_item_refs |
refuse_additional_operations |
refuse_unreadable_operations |
{
  "$schema": "https://basecamp.com/schemas/url-routes.json",
  version: "1.0.0",
  generated: true,
  routes: [
    .paths | to_entries[] |
    .key as $raw_path |
    (.key | gsub("\\.json$"; "")) as $pattern |
    .value as $path_item |

    # Collect all operations on this path.
    #
    # A Path Item Object is read by EXCLUSION: its non-operation fields are a
    # closed, spec-defined set and its extensions are x- prefixed, so every
    # OTHER field is an operation. Selecting a list of verbs instead is the
    # defect this replaces (#925) -- the Smithy @http trait takes the method as
    # a free-form string that Smithy "will use literally and will perform no
    # validation on", so an operation on any unlisted verb was dropped from the
    # route table in silence.
    #
    # Nothing downstream of here is verb-specific (a route operations map is
    # method -> operationId), so this walk takes no emission bound: it
    # represents whatever the spec declares. A $ref path item is refused above,
    # before the walk, because its operations cannot be counted without
    # resolving it.
    ($path_item | to_entries | map(
      select((.key | IN("summary","description","servers","parameters") | not)
             and (.key | startswith("x-") | not))
    )) as $ops |

    # Use the first operation tags as the resource tag
    ($ops | first | .value.tags // [] | first // null) as $resource |

    # Build operations map: method → operationId
    ([$ops[] | {key: (.key | ascii_upcase), value: .value.operationId}] | from_entries) as $operations |

    # Extract path parameters with roles and types.
    # Parameters may be at path level or operation level; merge both.
    (
      [
        (($path_item.parameters // [])[] | select(.in == "path")),
        (($ops[0].value.parameters // [])[] | select(.in == "path"))
      ] | unique_by(.name) |
      map({
        key: .name,
        value: {
          role: param_role(.name; $pattern),
          type: param_type
        }
      }) | from_entries
    ) as $params |

    {
      pattern: $pattern,
      resource: $resource,
      operations: $operations,
      params: $params
    }
  ] | sort_by(.pattern)
}
' "$OPENAPI_FILE" > "${OUTPUT_FILE}.tmp"

mv "${OUTPUT_FILE}.tmp" "$OUTPUT_FILE"

# Summary output
route_count=$(jq '.routes | length' "$OUTPUT_FILE")
resource_count=$(jq '[.routes[].resource] | unique | length' "$OUTPUT_FILE")
op_count=$(jq '[.routes[].operations | to_entries[]] | length' "$OUTPUT_FILE")

echo "Generated $OUTPUT_FILE"
echo "  Routes: $route_count (across $resource_count resources, $op_count operations)"
