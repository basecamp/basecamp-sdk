#!/usr/bin/env bash
#
# Self-test: the COMPILED generators refuse what they cannot emit, loudly.
#
# WHY THIS EXISTS SEPARATELY. scripts/test-generator-verb-inversion.rb drives the
# Ruby, Python and jq generators, because those run on the stdlib toolchains the
# Spec Gates job already has. TypeScript, Kotlin, Swift and Rust carry four more
# independent copies of the same walk, and nothing else in the repository can see
# a regression in them: their drift checks regenerate from the committed
# openapi.json, which declares four verbs and no unreadable path-item fields, so
# all four could revert to silently skipping an unknown verb with every drift
# check still green. This is the only gate that gives them one.
#
# It runs the REAL generator binary the language job already builds, and asserts
# four things per scenario: a non-zero exit, a message naming the offending
# operation, that no generated file was written, and that the output tree it was
# pointed at is UNTOUCHED — compared by content, so an overwrite is caught
# alongside a delete. That last assertion is the one with teeth: a generator that
# clears its output directory before validating turns a refusal into data loss,
# which the Kotlin generator did until this test was written. An EMPTY output
# directory cannot show that, so the directory is seeded first.
#
# FOUR SCENARIOS, one per guard the walk carries. They are a table rather than a
# list that grows by one each review round: a new guard in the shared walk gets a
# row here, because the live spec exercises none of them.
#
#   1. UNEMITTED VERB. A spec carrying a HEAD operation must be refused by name.
#   2. DECLARATION-SOURCED BOUND. Pointed at a declaration that omits a verb the
#      SDKs normally emit, the generator must refuse THAT verb too. A generator
#      still holding a private five-verb list would pass scenario 1 by rejecting
#      HEAD while ignoring spec/generated-verbs.json entirely — which is how
#      PATCH's removal from the declaration could go unenforced in four
#      languages.
#   3. MALFORMED DECLARATION. A verb is `[a-z]+` in all six loaders, and the
#      compiled four have to agree with the scripted two about that. Six
#      hand-written loaders that merely look equivalent are how a non-breaking
#      space came to be accepted in one language and refused in three.
#
# Usage: ./test-compiled-generator-refusal <typescript|kotlin|swift|rust>
#
# Each language's own CI job runs its own language, so nothing here can skip:
# the toolchain is present by construction wherever this is invoked.

set -euo pipefail

LANGUAGE="${1:-}"
if [[ -z "$LANGUAGE" ]]; then
  echo "usage: $0 <typescript|kotlin|swift|rust>" >&2
  exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

TMP="$(mktemp -d "${TMPDIR:-/tmp}/verb-refusal.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

# The crafted specs are derived from the committed openapi.json rather than from
# a fixture, so they cannot drift away from what the generators actually read.
# Moving an operation's verb from `get` to `head` is a change a Smithy author can
# make today: @http's method is a free-form string Smithy performs no validation
# on.
OPERATION="GetProject"
PATH_KEY="$(jq -r --arg op "$OPERATION" \
  'first(.paths | to_entries[] | select(.value.get.operationId == $op) | .key)' \
  "$ROOT_DIR/openapi.json")"
if [[ -z "$PATH_KEY" || "$PATH_KEY" == "null" ]]; then
  echo "FAIL: openapi.json no longer has a GET whose operationId is $OPERATION; pick another" >&2
  exit 1
fi
jq --arg p "$PATH_KEY" '.paths[$p].head = .paths[$p].get | del(.paths[$p].get)' \
  "$ROOT_DIR/openapi.json" > "$TMP/openapi-head.json"

# Scenario 2 needs a verb the real spec DOES use and the crafted declaration does
# not name. DELETE is chosen from the live declaration rather than hardcoded, so
# this keeps working if the declaration changes.
WITHHELD="$(jq -r '.verbs | map(select(. != "get")) | last' "$ROOT_DIR/spec/generated-verbs.json")"
# Uppercased with tr, not ${VAR^^}: the Swift job runs on macos-15, whose runner
# image ships Bash 3.2, where that expansion is a `bad substitution` and the
# script dies before any scenario runs.
WITHHELD_UPPER="$(printf '%s' "$WITHHELD" | tr '[:lower:]' '[:upper:]')"
jq --arg withheld "$WITHHELD" 'del(.verbs[] | select(. == $withheld))' \
  "$ROOT_DIR/spec/generated-verbs.json" > "$TMP/verbs-withheld.json"
WITHHELD_PATH="$(jq -r --arg v "$WITHHELD" \
  'first(.paths | to_entries[] | select(.value[$v].operationId) | .key)' "$ROOT_DIR/openapi.json")"
WITHHELD_OPERATION="$(jq -r --arg v "$WITHHELD" --arg p "$WITHHELD_PATH" \
  '.paths[$p][$v].operationId' "$ROOT_DIR/openapi.json")"
if [[ -z "$WITHHELD_PATH" || "$WITHHELD_PATH" == "null" ]]; then
  echo "FAIL: openapi.json has no $WITHHELD operation to withhold; adjust this test" >&2
  exit 1
fi

failures=0
scenario_number=0

# run_scenario <description> <spec> <verbs-declaration> <expected verb> <expected operationId>
run_scenario() {
  local description="$1" spec="$2" verbs="$3" expect_verb="$4" expect_name="$5"
  scenario_number=$((scenario_number + 1))
  local out="$TMP/out-$scenario_number" log="$TMP/generate-$scenario_number.log"
  local status=0

  # Seed the output directory the way a real run finds it: already holding the
  # committed generated tree. The seeds are then snapshotted by READING THE TREE
  # BACK rather than from the list below — macOS is case-insensitive, so Models/
  # and models/ are one directory there and two on the Linux runners, and a
  # literal list would disagree with the filesystem on one of them.
  mkdir -p "$out/models" "$out/services" "$out/Models" "$out/Services"
  local seed
  for seed in "$out/models/Sentinel.kt" "$out/services/Sentinel.kt" \
              "$out/Models/Sentinel.swift" "$out/Services/Sentinel.swift" \
              "$out/Metadata.kt" "$out/ServiceAccessors.kt" \
              "$out/sentinel.ts" "$out/sentinel.rs" "$out/mod.rs"; do
    echo "committed generated output; a refusal must not destroy this" > "$seed"
  done
  local seeded_paths="$TMP/seeded-$scenario_number" seeded_digests="$TMP/digests-$scenario_number"
  find "$out" -type f | LC_ALL=C sort > "$seeded_paths"
  xargs shasum < "$seeded_paths" > "$seeded_digests"

  case "$LANGUAGE" in
    typescript)
      (cd "$ROOT_DIR/typescript" && BASECAMP_GENERATED_VERBS="$verbs" \
        npx tsx scripts/generate-services.ts --openapi "$spec" --output "$out") \
        > "$log" 2>&1 || status=$?
      ;;
    kotlin)
      # The INSTALLED distribution, not the Gradle run task. Running the packaged
      # binary is what the other three languages do, and it keeps every Gradle
      # invocation in the Makefile recipe where scripts/check-gradle-serialization
      # can classify it: that gate resolves one level of script delegation and
      # attributes a delegated Gradle call to EVERY target that calls the script,
      # so invoking the wrapper from here would have marked the TypeScript, Swift
      # and Rust targets as Kotlin-project builds and demanded order-only edges
      # between them that describe no real collision. (The same reason this
      # comment names the wrapper in prose instead of spelling its command: the
      # gate reads text, and errs toward reporting.)
      local generator="$ROOT_DIR/kotlin/generator/build/install/generator/bin/generator"
      if [[ ! -x "$generator" ]]; then
        echo "FAIL [kotlin]: $generator is missing." >&2
        echo "  Build the generator distribution first; make kt-test-verb-refusal does it for you." >&2
        exit 1
      fi
      "$generator" --openapi "$spec" --behavior "$ROOT_DIR/behavior-model.json" \
        --verbs "$verbs" --output "$out" > "$log" 2>&1 || status=$?
      ;;
    swift)
      (cd "$ROOT_DIR/swift" && swift run BasecampGenerator \
        --openapi "$spec" --behavior "$ROOT_DIR/behavior-model.json" \
        --verbs "$verbs" --output "$out") > "$log" 2>&1 || status=$?
      ;;
    rust)
      (cd "$ROOT_DIR/rust" && cargo run -q --locked -p basecamp-sdk-generator -- \
        --openapi "$spec" --verbs "$verbs" --output "$out") > "$log" 2>&1 || status=$?
      ;;
    *)
      echo "unknown language: $LANGUAGE" >&2
      exit 2
      ;;
  esac

  local scenario_failed=0

  if [[ "$status" -eq 0 ]]; then
    echo "FAIL [$LANGUAGE] $description: the generator exited 0." >&2
    echo "  An operation this generator cannot emit must stop the run, not vanish from the client." >&2
    scenario_failed=1
  fi

  if ! grep -qi "$expect_verb" "$log" || ! grep -q "$expect_name" "$log"; then
    echo "FAIL [$LANGUAGE] $description: the failure message does not name the offending operation." >&2
    echo "  Expected $expect_verb and $expect_name in the output; got:" >&2
    sed 's/^/    /' "$log" >&2
    scenario_failed=1
  fi

  if ! shasum --check --status "$seeded_digests"; then
    echo "FAIL [$LANGUAGE] $description: the refusal DESTROYED or REWROTE committed output:" >&2
    shasum --check "$seeded_digests" 2>&1 | grep -v ': OK$' | sed 's/^/    /' >&2
    echo "  Validate the whole spec before clearing or writing the output tree, so a refusal" >&2
    echo "  leaves the committed generated code exactly as it found it." >&2
    scenario_failed=1
  fi

  # Every file under the output directory must be one of the seeds, BY PATH.
  # Excluding the seeds by NAME would excuse a real generated Metadata.kt or
  # mod.rs, which are exactly the names a refusing generator might still write.
  local actual_paths="$TMP/actual-$scenario_number" extra
  find "$out" -type f | LC_ALL=C sort > "$actual_paths"
  extra="$(LC_ALL=C comm -13 "$seeded_paths" "$actual_paths")"
  if [[ -n "$extra" ]]; then
    echo "FAIL [$LANGUAGE] $description: the refusal still wrote generated files:" >&2
    echo "$extra" | sed 's/^/    /' >&2
    scenario_failed=1
  fi

  if [[ "$scenario_failed" -ne 0 ]]; then
    failures=1
  else
    echo "OK [$LANGUAGE] $description: refused by name, exit $status, nothing written, nothing destroyed"
  fi
}

run_scenario "HEAD $PATH_KEY ($OPERATION) is not an emitted verb" \
  "$TMP/openapi-head.json" "$ROOT_DIR/spec/generated-verbs.json" "HEAD" "$OPERATION"

run_scenario "the declaration withholds $WITHHELD_UPPER, so $WITHHELD_UPPER $WITHHELD_PATH ($WITHHELD_OPERATION) is refused" \
  "$ROOT_DIR/openapi.json" "$TMP/verbs-withheld.json" "$WITHHELD_UPPER" "$WITHHELD_OPERATION"

# Scenario 3: a MALFORMED declaration. A verb is `[a-z]+` in all six loaders, a
# positive rule chosen because two review rounds of "what counts as blank"
# diverged by language (Java's Character.isWhitespace excludes U+00A0, Rust's
# char::is_whitespace includes it, Ruby's String#strip is ASCII-only). The entry
# below is a non-breaking space: it is the shape that told those loaders apart,
# so it is the one worth asserting against the compiled ones.
jq '.verbs += ["\u00a0"]' "$ROOT_DIR/spec/generated-verbs.json" > "$TMP/verbs-malformed.json"
run_scenario "a declaration entry that is not [a-z]+ is refused" \
  "$ROOT_DIR/openapi.json" "$TMP/verbs-malformed.json" "verbs" "a-z"

# Scenario 4: OpenAPI 3.2's additionalOperations, a MAP of method to Operation.
# The bounded walkers would reject an unknown VERB, but this field is not a verb
# — read as one operation it carries no operationId, and before the guard the
# verb-agnostic walkers dropped every operation inside it in silence. Neither
# scenario above contains the map and neither does the live spec, so without this
# the guard could regress in all four binaries with every check green.
jq --arg p "$PATH_KEY" \
  '.paths[$p].additionalOperations = {"PURGE": .paths[$p].get}' \
  "$ROOT_DIR/openapi.json" > "$TMP/openapi-additional.json"
run_scenario "an additionalOperations map is refused rather than read as one operation" \
  "$TMP/openapi-additional.json" "$ROOT_DIR/spec/generated-verbs.json" \
  "additionalOperations" "$PATH_KEY"

exit "$failures"
