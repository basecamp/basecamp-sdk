#!/usr/bin/env bash
#
# Runs the generation pipeline so that a refusal at ANY step leaves the committed
# generated tree exactly as it found it.
#
# WHY A WRAPPER AND NOT MORE PREFLIGHT. `npm run generate` is five steps in five
# processes, and the first of them overwrites committed artifacts
# (`openapi-stripped.json`, then `schema.d.ts`) while later steps can still
# refuse. scripts/check-path-items.ts was hoisted in front of the chain to catch
# the path-item refusals, and it does — but it only knows about path items.
# `patch-flexible-ids.ts` exits non-zero when the Person schema layout moves, and
# `extract-person-id-sites.ts` has failure modes of its own, so extending the
# preflight would mean adding one predicate per refusal anyone finds: a list that
# grows by a round, which is the shape this whole change set exists to stop.
#
# Kotlin, Swift and Rust make the class unreachable by rendering every file in
# memory and writing last. That is not available across five processes, one of
# which is a third-party binary writing its own output. This is the equivalent
# guarantee from the outside: snapshot the tree, run the chain, and restore the
# snapshot if any step fails. Which step refused, and why, stops mattering.
#
# The preflight stays in front of it. It is not redundant — it turns the common
# failure into a named message before five steps of work, where this wrapper is
# what makes the guarantee hold for the failures nobody has enumerated.
#
# Usage: scripts/generate-atomically <command...>   (run from typescript/)

set -euo pipefail

GENERATED_DIR="src/generated"

if [[ ! -d "$GENERATED_DIR" ]]; then
  # Nothing committed to protect — a first generation into an empty tree.
  exec "$@"
fi

SNAPSHOT="$(mktemp -d "${TMPDIR:-/tmp}/generated-snapshot.XXXXXX")"
cp -R "$GENERATED_DIR/." "$SNAPSHOT/"

restore() {
  local status=$?
  if [[ "$status" -ne 0 ]]; then
    rm -rf "$GENERATED_DIR"
    mkdir -p "$GENERATED_DIR"
    cp -R "$SNAPSHOT/." "$GENERATED_DIR/"
    echo "generate: a step refused (exit $status); $GENERATED_DIR restored unchanged" >&2
  fi
  rm -rf "$SNAPSHOT"
  exit "$status"
}
trap restore EXIT

"$@"
